@model ContractingPlatform.Application.DTOs.Admin.PlatformStatisticsDto
@{
    ViewData["Title"] = "لوحة القيادة والإدارة العامة - منصة بُنيان";
    var stats = Model;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge-soft-primary mb-2 d-inline-block">الإدارة والرقابة المركزية</span>
            <h2 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2 text-primary"></i>
                <span>لوحة تحكم المنظومة والمؤشرات الحيوية</span>
            </h2>
            <p class="text-muted small mb-0">نظرة استراتيجية شاملة على حجم التدفقات المالية للضمان، التراخيص والسجلات، وسير المشاريع.</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="Finances" class="btn btn-outline-success">
                <i class="bi bi-bank2 me-1"></i> الرقابة المالية والضمان
            </a>
            <a asp-action="Contractors" class="btn btn-outline-custom">
                <i class="bi bi-shield-check text-warning me-1"></i> فحص التراخيص
            </a>
            <a asp-action="Projects" class="btn btn-primary-custom">
                <i class="bi bi-kanban me-1"></i> المشاريع الميدانية
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="row g-4 mb-5">
        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">إجمالي المشاريع</span>
                        <h3 class="fw-extrabold text-dark mb-0">@stats.TotalProjects</h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(11, 19, 43, 0.06); color: var(--brand-navy); width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                    <span class="badge-soft-success">@stats.ActiveProjects قيد التنفيذ</span>
                    <span class="badge-soft-primary">@stats.OpenProjects مفتوح</span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">إجمالي قيمة التعاقدات (Escrow)</span>
                        <h3 class="fw-extrabold text-success mb-0">
                            @(((decimal)stats.TotalVolume).ToString("N0")) <small class="fs-6 fw-normal text-muted">ر.س</small>
                        </h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(16, 185, 129, 0.1); color: var(--escrow-emerald); width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
                <div class="pt-2 border-top small d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted">عمولات المنصة: </span>
                        <strong class="text-dark">@(((decimal)stats.TotalPlatformCommission).ToString("N0")) ر.س</strong>
                    </div>
                    <a asp-action="Finances" class="text-decoration-none small fw-bold text-success">
                        التدقيق المالي <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">المقاولون والمنشآت</span>
                        <h3 class="fw-extrabold text-dark mb-0">@stats.TotalContractors</h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(245, 158, 11, 0.1); color: var(--accent-amber); width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-tools"></i>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                    <span class="badge-soft-success">@stats.ApprovedContractors معتمد</span>
                    <span class="badge-soft-warning">@stats.PendingContractors بانتظار الفحص</span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">العملاء والعروض</span>
                        <h3 class="fw-extrabold text-dark mb-0">@stats.TotalClients</h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(14, 165, 233, 0.1); color: #0284c7; width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="pt-2 border-top small text-muted">
                    <span>إجمالي العروض المقدمة: </span>
                    <strong class="text-dark">@stats.TotalBids عرض</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Operations & Quick Actions -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge-soft-warning mb-2 d-inline-block">التوثيق والتراخيص</span>
                        <h4 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-patch-check-fill text-warning"></i>
                            <span>فحص وتدقيق المنشآت</span>
                        </h4>
                    </div>
                    <a asp-action="Contractors" class="btn btn-outline-custom btn-sm">سجل المقاولين</a>
                </div>
                <p class="text-secondary small mb-4" style="line-height: 1.7;">
                    التحقق من صحة السجلات التجارية وتراخيص المقاولين المعتمدة لدى وزارة التجارة والهيئة السعودية للمقاولين لضمان موثوقية المنظومة.
                </p>
                <div class="mt-auto">
                    <a asp-action="Contractors" class="btn btn-primary-custom w-100 d-flex align-items-center justify-content-center gap-2">
                        <span>فحص طلبات الاعتماد الجديدة (@stats.PendingContractors طلب)</span>
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge-soft-primary mb-2 d-inline-block">الميدان والرقابة</span>
                        <h4 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-kanban-fill text-primary"></i>
                            <span>متابعة العقود والمشاريع</span>
                        </h4>
                    </div>
                    <a asp-action="Projects" class="btn btn-outline-custom btn-sm">استعراض المشاريع</a>
                </div>
                <p class="text-secondary small mb-4" style="line-height: 1.7;">
                    متابعة سير مراحل الأعمال الإنشائية والتشطيبية، وتتبع حالات حساب الضمان المشترك ومراقبة مؤشرات الرضا وتسوية الملاحظات.
                </p>
                <div class="mt-auto">
                    <a asp-action="Projects" class="btn btn-outline-custom w-100 d-flex align-items-center justify-content-center gap-2">
                        <span>عرض كافة المشاريع قيد التنفيذ والمنتهية</span>
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
