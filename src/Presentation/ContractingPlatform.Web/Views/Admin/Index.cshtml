@{
    ViewData["Title"] = "لوحة تحكم الإدارة العامة - منصة بُنيان";
    dynamic stats = ViewBag.Stats;
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-danger me-2"></i>لوحة تحكم وإدارة المنصة</h3>
        <p class="text-muted small mb-0">نظرة شاملة على أداء المنصة، المعاملات المالية، وعمليات التوثيق</p>
    </div>

    <!-- Stats Grid -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card card-custom p-4 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block mb-1">إجمالي المشاريع</span>
                        <h3 class="fw-bold mb-0">@stats.TotalProjects</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-briefcase fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <span class="text-success fw-bold">@stats.ActiveProjects</span> جاري التنفيذ | <span class="text-primary fw-bold">@stats.OpenProjects</span> مفتوح
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card card-custom p-4 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block mb-1">حجم المعاملات والتعاقدات</span>
                        <h3 class="fw-bold mb-0 text-success">@(((decimal)stats.TotalVolume).ToString("N0")) <small class="fs-6">ر.س</small></h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    عمولات المنصة المحصلة: <strong>@(((decimal)stats.TotalPlatformCommission).ToString("N0")) ر.س</strong>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card card-custom p-4 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block mb-1">المقاولون والمنشآت</span>
                        <h3 class="fw-bold mb-0">@stats.TotalContractors</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-tools fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    <span class="text-success fw-bold">@stats.ApprovedContractors</span> معتمد | <span class="text-warning fw-bold">@stats.PendingContractors</span> بانتظار الفحص
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card card-custom p-4 border-start border-info border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block mb-1">العملاء والطلبات</span>
                        <h3 class="fw-bold mb-0">@stats.TotalClients</h3>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                </div>
                <div class="mt-2 small text-muted">
                    إجمالي عروض الأسعار: <strong>@stats.TotalBids عرض</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Cards -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card card-custom p-4 border">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-shield-check text-warning me-2"></i>طلبات توثيق المنشآت</h5>
                    <a asp-action="Contractors" class="btn btn-outline-primary btn-sm">إدارة كافة المقاولين</a>
                </div>
                <p class="text-muted small mb-3">فحص السجلات التجارية والتراخيص الرسمية للمقاولين لضمان موثوقية المنصة وجودة التنفيذ.</p>
                <a asp-action="Contractors" class="btn btn-primary-custom">
                    فحص طلبات التوثيق المعلقة (@stats.PendingContractors)
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card card-custom p-4 border">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-kanban text-primary me-2"></i>مراقبة كافة المشاريع</h5>
                    <a asp-action="Projects" class="btn btn-outline-primary btn-sm">استعراض المشاريع</a>
                </div>
                <p class="text-muted small mb-3">متابعة كافة طلبات المشاريع المنشورة، نسب الإنجاز، وفض النزاعات إن وجدت.</p>
                <a asp-action="Projects" class="btn btn-outline-primary">
                    عرض كافة المشاريع الميدانية
                </a>
            </div>
        </div>
    </div>
</div>
