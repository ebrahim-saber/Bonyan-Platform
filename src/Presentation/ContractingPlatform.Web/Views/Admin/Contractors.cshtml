@using ContractingPlatform.Domain.Entities
@using ContractingPlatform.Domain.Enums
@model List<ContractorProfile>
@{
    ViewData["Title"] = "إدارة وتوثيق المقاولين والمنشآت";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-shield-check text-warning me-2"></i>إدارة وتوثيق منشآت المقاولات</h3>
            <p class="text-muted small mb-0">مراجعة بيانات السجل التجاري والترخيص واعتماد أو رفض حسابات المنشآت</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">العودة للوحة التحكم</a>
    </div>

    <div class="table-responsive bg-white rounded-3 shadow-sm border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-3 px-4">اسم المنشأة</th>
                    <th>السجل التجاري</th>
                    <th>المسؤول</th>
                    <th>المدينة</th>
                    <th>الخبرة</th>
                    <th>حالة التوثيق</th>
                    <th class="text-end px-4">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="px-4 fw-bold">
                            <div>@c.CompanyName</div>
                            <small class="text-muted">@(c.Bio?.Length > 60 ? c.Bio.Substring(0, 60) + "..." : c.Bio)</small>
                        </td>
                        <td><code>@c.CommercialRegistrationNo</code></td>
                        <td>
                            <div>@c.User.FullName</div>
                            <small class="text-muted">@c.User.PhoneNumber</small>
                        </td>
                        <td>@c.City</td>
                        <td>@c.YearsOfExperience سنوات</td>
                        <td>
                            <span class="badge @(c.VerificationStatus == VerificationStatus.Approved ? "bg-success" : c.VerificationStatus == VerificationStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">
                                @(c.VerificationStatus switch {
                                    VerificationStatus.Approved => "معتمد وموثق",
                                    VerificationStatus.Rejected => "مرفوض",
                                    _ => "بانتظار الفحص"
                                })
                            </span>
                        </td>
                        <td class="text-end px-4">
                            @if (c.VerificationStatus != VerificationStatus.Approved)
                            {
                                <form asp-action="UpdateContractorStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="status" value="@VerificationStatus.Approved" />
                                    <input type="hidden" name="notes" value="تم التحقق من صحة السجل التجاري ومطابقة البيانات" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check-circle me-1"></i> اعتماد
                                    </button>
                                </form>
                            }
                            @if (c.VerificationStatus != VerificationStatus.Rejected)
                            {
                                <form asp-action="UpdateContractorStatus" method="post" class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="status" value="@VerificationStatus.Rejected" />
                                    <input type="hidden" name="notes" value="السجل التجاري غير ساري أو غير مطابق لنشاط المقاولات" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-x-circle me-1"></i> رفض
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
