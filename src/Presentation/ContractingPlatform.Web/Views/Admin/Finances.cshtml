@using ContractingPlatform.Domain.Enums
@model ContractingPlatform.Application.DTOs.Admin.AdminFinancialDashboardDto
@{
    ViewData["Title"] = "الرقابة المالية والضمان البنكي (Escrow) - منصة بُنيان";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge-soft-success">الرقابة المالية والضمان المشترك</span>
                <span class="badge bg-dark text-white"><i class="bi bi-shield-lock-fill me-1"></i> Escrow Secured</span>
            </div>
            <h2 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-bank2 text-success"></i>
                <span>لوحة الرقابة المالية وإدارة حسابات الضمان</span>
            </h2>
            <p class="text-muted small mb-0">متابعة دقيقة وتدقيق لحظي لتدفقات الأموال المجمدة، عمليات الصرف الميداني، والعمولات المحصلة.</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-custom">
                <i class="bi bi-speedometer2 me-1"></i> لوحة الإدارة
            </a>
            <button onclick="window.print();" class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> طباعة التقرير المالي
            </button>
        </div>
    </div>

    <!-- Financial KPI Cards -->
    <div class="row g-4 mb-4">
        <!-- Held In Escrow (Crucial) -->
        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">المحجوز حالياً بالضمان (Escrow)</span>
                        <h3 class="fw-extrabold text-primary mb-0 font-monospace">
                            @Model.TotalHeldInEscrow.ToString("N0") <small class="fs-6 fw-normal text-muted">ر.س</small>
                        </h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(2, 132, 199, 0.1); color: #0284c7; width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                </div>
                <div class="pt-2 border-top small text-muted d-flex justify-content-between align-items-center">
                    <span>أموال مؤمنة للمشاريع الجارية</span>
                    <span class="badge bg-primary">مؤمن بنكياً</span>
                </div>
            </div>
        </div>

        <!-- Released to Contractors -->
        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">المصروف الفعلي للمقاولين</span>
                        <h3 class="fw-extrabold text-success mb-0 font-monospace">
                            @Model.TotalReleasedToContractors.ToString("N0") <small class="fs-6 fw-normal text-muted">ر.س</small>
                        </h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981; width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="pt-2 border-top small text-muted d-flex justify-content-between align-items-center">
                    <span>تم تحريرها بعد اعتماد المراحل</span>
                    <span class="badge bg-success">مصروف</span>
                </div>
            </div>
        </div>

        <!-- Platform Commission -->
        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">إجمالي عمولات المنصة (5%)</span>
                        <h3 class="fw-extrabold text-warning text-dark mb-0 font-monospace">
                            @Model.TotalPlatformCommission.ToString("N0") <small class="fs-6 fw-normal text-muted">ر.س</small>
                        </h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
                <div class="pt-2 border-top small text-muted d-flex justify-content-between align-items-center">
                    <span>إيرادات منصة بُنيان المحققة</span>
                    <span class="badge bg-light text-dark border">عمولة 5%</span>
                </div>
            </div>
        </div>

        <!-- Total Contract Volume -->
        <div class="col-lg-3 col-sm-6">
            <div class="card card-custom p-4 h-100 border-start border-4 border-secondary">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">إجمالي التعاقدات المنفذة</span>
                        <h3 class="fw-extrabold text-dark mb-0 font-monospace">
                            @Model.TotalContractVolume.ToString("N0") <small class="fs-6 fw-normal text-muted">ر.س</small>
                        </h3>
                    </div>
                    <div class="category-icon-box" style="background: rgba(15, 23, 42, 0.08); color: #0f172a; width: 48px; height: 48px; font-size: 1.3rem;">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>
                <div class="pt-2 border-top small text-muted d-flex justify-content-between align-items-center">
                    <span>@Model.ActiveEscrowContractsCount عقود نشطة حالياً</span>
                    <span class="badge bg-secondary">@Model.TotalTransactionsCount معاملة</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Escrow Transactions Log -->
    <div class="card card-custom p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-text text-primary"></i>
                    <span>سجل المعاملات البنكية وحركات الضمان (Audit Trail)</span>
                </h5>
                <p class="text-muted small mb-0">كافة العمليات البنكية المسجلة على النظام مع تفاصيل الرسوم والسندات المعتمدة.</p>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                عرض آخر @Model.RecentTransactions.Count معاملة
            </span>
        </div>

        @if (Model.RecentTransactions.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-cash-stack fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <h6 class="fw-bold text-dark">لا توجد معاملات مالية مسجلة بعد</h6>
                <p class="text-muted small mb-0">عندما يقوم العملاء بسداد وتأمين دفعات العقود، ستظهر بياناتها البنكية فورياً هنا.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="py-3 px-3">رقم المرجع البنكي</th>
                            <th>المشروع والمرحلة</th>
                            <th>العميل</th>
                            <th>المقاول</th>
                            <th>وسيلة الدفع</th>
                            <th>إجمالي الدفعة</th>
                            <th>عمولة المنصة</th>
                            <th>صافي المقاول</th>
                            <th>حالة الضمان</th>
                            <th class="text-end px-3">السند والفاتورة</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr>
                                <td class="px-3">
                                    <div class="fw-bold font-monospace text-dark">@tx.TransactionReference</div>
                                    <small class="text-muted" style="font-size: 0.72rem;">@tx.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 180px;">@tx.ProjectTitle</div>
                                    <small class="text-muted">مرحلة: @tx.MilestoneTitle</small>
                                </td>
                                <td>@tx.ClientName</td>
                                <td>
                                    <div class="fw-semibold">@tx.ContractorCompanyName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-credit-card me-1"></i> @tx.Method
                                    </span>
                                </td>
                                <td class="fw-bold font-monospace">@tx.Amount.ToString("N0") ر.س</td>
                                <td class="text-muted font-monospace">@tx.FeeAmount.ToString("N0") ر.س</td>
                                <td class="fw-bold text-success font-monospace">@tx.NetAmount.ToString("N0") ر.س</td>
                                <td>
                                    @if (tx.Status == PaymentStatus.HeldInEscrow)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                            <i class="bi bi-lock-fill me-1"></i> محجوز بالضمان
                                        </span>
                                    }
                                    else if (tx.Status == PaymentStatus.ReleasedToContractor)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="bi bi-check-all me-1"></i> مصروف للمقاول
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@tx.Status</span>
                                    }
                                </td>
                                <td class="text-end px-3">
                                    <a asp-controller="Payments" asp-action="Receipt" asp-route-reference="@tx.TransactionReference" target="_blank" class="btn btn-outline-primary btn-sm py-1 px-2" title="معاينة سند القبض والفاتورة الضريبية">
                                        <i class="bi bi-receipt me-1"></i> السند
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
