@using ContractingPlatform.Application.DTOs.Contracts
@model ContractingPlatform.Application.DTOs.Reviews.CreateReviewDto
@{
    ViewData["Title"] = "تقييم أداء المقاول";
    var contract = ViewBag.Contract as ContractDetailsDto;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            @if (contract != null)
            {
                <div class="card card-custom p-4 mb-4 border bg-light">
                    <span class="badge bg-primary w-auto d-inline-block mb-2">عقد رقم #@contract.Id</span>
                    <h4 class="fw-bold mb-1">@contract.ProjectTitle</h4>
                    <p class="text-muted small mb-0">المقاول: <strong>@contract.ContractorCompanyName</strong></p>
                </div>
            }

            <div class="card card-custom p-4 p-md-5 border">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center p-3 mb-2">
                        <i class="bi bi-star-fill fs-1"></i>
                    </div>
                    <h3 class="fw-bold">تقييم تجربة المشروع مع المقاول</h3>
                    <p class="text-muted small">تقييمك الصادق يساهم في رفع جودة الخدمات وتحفيز المقاولين المتميزين</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProjectContractId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="OverallRating" class="form-label fw-bold small">التقييم العام (من 1 إلى 5 نجوم)</label>
                        <select asp-for="OverallRating" class="form-select">
                            <option value="5">⭐⭐⭐⭐⭐ ممتاز جداً (5 نجوم)</option>
                            <option value="4">⭐⭐⭐⭐ جيد جداً (4 نجوم)</option>
                            <option value="3">⭐⭐⭐ جيد (3 نجوم)</option>
                            <option value="2">⭐⭐ مقبول (نجمتان)</option>
                            <option value="1">⭐ ضعيف (نجمة واحدة)</option>
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="QualityRating" class="form-label fw-bold small">جودة التنفيذ والتشطيب</label>
                            <select asp-for="QualityRating" class="form-select">
                                <option value="5">5 من 5</option>
                                <option value="4">4 من 5</option>
                                <option value="3">3 من 5</option>
                                <option value="2">2 من 5</option>
                                <option value="1">1 من 5</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PunctualityRating" class="form-label fw-bold small">الالتزام بالمواعيد</label>
                            <select asp-for="PunctualityRating" class="form-select">
                                <option value="5">5 من 5</option>
                                <option value="4">4 من 5</option>
                                <option value="3">3 من 5</option>
                                <option value="2">2 من 5</option>
                                <option value="1">1 من 5</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CommunicationRating" class="form-label fw-bold small">التعامل وسرعة التجاوب</label>
                            <select asp-for="CommunicationRating" class="form-select">
                                <option value="5">5 من 5</option>
                                <option value="4">4 من 5</option>
                                <option value="3">3 من 5</option>
                                <option value="2">2 من 5</option>
                                <option value="1">1 من 5</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Comment" class="form-label fw-bold small">رأيك وتوصيتك التفصيلية (اختياري)</label>
                        <textarea asp-for="Comment" rows="4" class="form-control" placeholder="اكتب تعليقك حول دقة العمل، نظافة الموقع، وحسن المعاملة..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-grow-1 py-3 fw-bold fs-5">
                            <i class="bi bi-check-circle me-1"></i> حفظ وإرسال التقييم
                        </button>
                        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ProjectContractId" class="btn btn-outline-secondary px-4 py-3">
                            تخطي
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
