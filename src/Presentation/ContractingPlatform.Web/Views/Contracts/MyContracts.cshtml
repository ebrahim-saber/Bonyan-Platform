@using ContractingPlatform.Domain.Enums
@using ContractingPlatform.Application.DTOs.Contracts
@model List<ContractDetailsDto>
@{
    ViewData["Title"] = "العقود والمشاريع التنفيذية";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="bi bi-file-earmark-text text-primary me-2"></i>العقود والمشاريع التنفيذية</h3>
        <p class="text-muted small mb-0">متابعة سير المراحل التنفيذية، تواريخ الإنجاز، والدفعات المحمية</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center">
            <i class="bi bi-file-earmark-x text-muted display-3 mb-3"></i>
            <h4 class="fw-bold">لا توجد عقود نشطة حالياً</h4>
            <p class="text-muted small mb-0">العقود تظهر تلقائياً بمجرد قبول العميل لأحد عروض الأسعار المقدمة.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model)
            {
                <div class="col-lg-6">
                    <div class="card card-custom h-100 p-4 border">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary fs-6">عقد #@c.Id</span>
                            <span class="badge @(c.Status == ProjectStatus.Completed ? "bg-success" : "bg-warning text-dark")">
                                @(c.Status == ProjectStatus.Completed ? "مكتمل" : "جاري العمل")
                            </span>
                        </div>
                        <h4 class="fw-bold mb-2">@c.ProjectTitle</h4>
                        <div class="text-muted small mb-3">
                            <span class="d-block mb-1"><i class="bi bi-person me-1"></i> العميل: <strong>@c.ClientName</strong></span>
                            <span class="d-block mb-1"><i class="bi bi-tools me-1"></i> المنشأة المنفذة: <strong>@c.ContractorCompanyName</strong></span>
                            <span><i class="bi bi-calendar3 me-1"></i> تاريخ البدء: @c.StartDate.ToString("yyyy/MM/dd")</span>
                        </div>

                        <div class="bg-light p-3 rounded d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="small text-muted d-block">إجمالي العقد:</span>
                                <span class="fw-bold fs-5 text-primary">@c.TotalAmount.ToString("N0") ر.س</span>
                            </div>
                            <div class="text-end">
                                <span class="small text-muted d-block">المراحل:</span>
                                <span class="fw-bold">@c.Milestones.Count مراحل</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-primary-custom w-100">
                                متابعة مراحل التنفيذ والدفعات <i class="bi bi-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
