@using ContractingPlatform.Domain.Enums
@model ContractingPlatform.Application.DTOs.Contracts.PrintableContractDto
@{
    Layout = null; // Independent printable layout
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>وثيقة عقد المقاولات الموحد - @Model.ContractNumber</title>
    
    <!-- Fonts & Bootstrap RTL -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            margin: 0;
            padding: 20px 0;
        }

        .contract-paper {
            max-width: 920px;
            margin: 0 auto;
            background: #ffffff;
            padding: 50px 60px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            position: relative;
        }

        .contract-header {
            border-bottom: 2px solid #0f172a;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .clause-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: #0f172a;
            margin-top: 24px;
            margin-bottom: 12px;
            padding-bottom: 6px;
            border-bottom: 1px dashed #cbd5e1;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .clause-text {
            font-size: 0.92rem;
            line-height: 1.85;
            color: #334155;
            text-align: justify;
            margin-bottom: 14px;
        }

        .party-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 16px 20px;
            margin-bottom: 15px;
        }

        .party-box table td {
            padding: 4px 8px;
            font-size: 0.88rem;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            font-size: 0.88rem;
        }

        .schedule-table th {
            background-color: #f1f5f9;
            color: #0f172a;
            font-weight: 700;
            padding: 10px 12px;
            border: 1px solid #cbd5e1;
            text-align: right;
        }

        .schedule-table td {
            padding: 10px 12px;
            border: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .signature-box {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 20px;
            min-height: 140px;
            background-color: #fafbfc;
            text-align: center;
        }

        .seal-stamp {
            display: inline-block;
            border: 2px dashed #0284c7;
            color: #0284c7;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 6rem;
            font-weight: 900;
            color: rgba(15, 23, 42, 0.025);
            pointer-events: none;
            white-space: nowrap;
            user-select: none;
            z-index: 1;
        }

        .top-action-bar {
            max-width: 920px;
            margin: 0 auto 20px auto;
            padding: 12px 20px;
            background: #ffffff;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .contract-paper {
                box-shadow: none;
                border: none;
                padding: 0;
                max-width: 100%;
            }
            .top-action-bar {
                display: none !important;
            }
            .page-break {
                page-break-before: always;
            }
            .avoid-break {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>

    <!-- Action Bar (hidden on print) -->
    <div class="top-action-bar no-print">
        <div class="d-flex align-items-center gap-3">
            <a href="@Url.Action("Details", "Contracts", new { id = Model.Id })" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right me-1"></i> العودة للعقد الميداني
            </a>
            <span class="text-muted small">| رقم الوثيقة: <strong>@Model.ContractNumber</strong></span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print();" class="btn btn-primary btn-sm px-3 fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-printer-fill"></i>
                <span>طباعة الوثيقة / حفظ كملف PDF</span>
            </button>
        </div>
    </div>

    <!-- Contract Paper -->
    <div class="contract-paper position-relative">
        <div class="watermark">بُنيان للتعاقد والضمان</div>

        <!-- Official Header -->
        <div class="contract-header">
            <div class="row align-items-center">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div style="width: 32px; height: 32px; background: #0f172a; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-hammer text-warning"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-0">منصة بُنيان الرقمية للمقاولات والتشطيب</h4>
                    </div>
                    <p class="text-muted small mb-0">المملكة العربية السعودية | منظومة التعاقد الإلكتروني والضمان المالي (Escrow)</p>
                    <small class="text-secondary" style="font-size: 0.78rem;">متوافق مع نظام كود البناء السعودي (SBC) واللوائح التنفيذية للمقاولات</small>
                </div>
                <div class="col-5 text-start">
                    <div class="text-muted small">رقم العقد الموحد:</div>
                    <div class="fw-bold fs-5 text-dark font-monospace">@Model.ContractNumber</div>
                    <div class="text-muted small mt-1">تاريخ التعاقد: <strong>@Model.ContractDate.ToString("yyyy/MM/dd") م</strong></div>
                    <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 small mt-1">
                        <i class="bi bi-shield-lock-fill me-1"></i> عقد محمي بنظام الضمان المالي
                    </div>
                </div>
            </div>
        </div>

        <!-- Contract Title -->
        <div class="text-center mb-4">
            <h3 class="fw-extrabold text-dark mb-1">عقد مقاولات وتوريد وتنفيذ أعمال وتشطيب</h3>
            <p class="text-muted small mb-0">مشروع: <strong>@Model.ProjectTitle</strong> (@Model.CategoryName)</p>
        </div>

        <!-- Preamble / Parties Identification -->
        <div class="clause-text">
            بعون الله وتوفيقه، تم إبرام هذا العقد في يوم <strong>@Model.ContractDate.ToString("dddd")</strong> الموافق <strong>@Model.ContractDate.ToString("yyyy/MM/dd") م</strong>، عبر منصة "بُنيان" الرقمية للتعاقد والضمان المالي، بين كلاً من:
        </div>

        <!-- First Party Box -->
        <div class="party-box avoid-break">
            <div class="fw-bold text-dark mb-2 d-flex justify-content-between">
                <span><i class="bi bi-person-fill text-primary me-1"></i> الطرف الأول (صاحب العمل / العميل):</span>
                <span class="badge bg-light text-dark border">صاحب المشروع</span>
            </div>
            <table class="w-100">
                <tr>
                    <td style="width: 18%;" class="text-muted">الاسم الكامل:</td>
                    <td style="width: 32%;" class="fw-bold">@Model.ClientFullName</td>
                    <td style="width: 18%;" class="text-muted">رقم الهوية / الإقامة:</td>
                    <td style="width: 32%;" class="fw-bold">@Model.ClientNationalIdOrIqama</td>
                </tr>
                <tr>
                    <td class="text-muted">رقم الجوال:</td>
                    <td class="fw-bold font-monospace">@Model.ClientPhone</td>
                    <td class="text-muted">البريد الإلكتروني:</td>
                    <td class="fw-bold">@Model.ClientEmail</td>
                </tr>
                <tr>
                    <td class="text-muted">العنوان والمدينة:</td>
                    <td colspan="3">@Model.City - @Model.District @(!string.IsNullOrEmpty(Model.DetailedAddress) ? $"({Model.DetailedAddress})" : "")</td>
                </tr>
            </table>
        </div>

        <!-- Second Party Box -->
        <div class="party-box avoid-break">
            <div class="fw-bold text-dark mb-2 d-flex justify-content-between">
                <span><i class="bi bi-tools text-warning me-1"></i> الطرف الثاني (المقاول المنفذ):</span>
                <span class="badge @(Model.IsContractorVerified ? "bg-success" : "bg-secondary")">
                    @(Model.IsContractorVerified ? "منشأة معتمدة وموثقة" : "منشأة مسجلة")
                </span>
            </div>
            <table class="w-100">
                <tr>
                    <td style="width: 18%;" class="text-muted">اسم المنشأة:</td>
                    <td style="width: 32%;" class="fw-bold">@Model.ContractorCompanyName</td>
                    <td style="width: 18%;" class="text-muted">رقم السجل التجاري:</td>
                    <td style="width: 32%;" class="fw-bold font-monospace">@Model.CommercialRegistrationNo</td>
                </tr>
                <tr>
                    <td class="text-muted">المفوض بالتوقيع:</td>
                    <td class="fw-bold">@Model.ContractorRepresentativeName</td>
                    <td class="text-muted">الرقم الضريبي (VAT):</td>
                    <td class="fw-bold font-monospace">@(Model.TaxNumber ?? "300012345678003")</td>
                </tr>
                <tr>
                    <td class="text-muted">رقم الاتصال:</td>
                    <td class="fw-bold font-monospace">@Model.ContractorPhone</td>
                    <td class="text-muted">البريد المعتمد:</td>
                    <td class="fw-bold">@Model.ContractorEmail</td>
                </tr>
            </table>
        </div>

        <!-- Clause 1: Subject & Scope -->
        <div class="clause-title">
            <span>البند الأول: موضوع ونطاق العقد وموقعه</span>
        </div>
        <div class="clause-text">
            يُقر الطرف الثاني (المقاول) بأنه اطلع على موقع العمل في مدينة <strong>@Model.City</strong> - حي <strong>@Model.District</strong>، وعاين كافة المخططات والمواصفات الفنية والمتطلبات الهندسية لمشروع <strong>"@Model.ProjectTitle"</strong>، ووافق على تنفيذ وإتمام كافة الأعمال وفق أعلى معايير الجودة والأصول المهنية المعتمدة في كود البناء السعودي، وتوفير كافة العمالة الماهرة والمواد والآلات والمعدات اللازمة.
        </div>

        <!-- Clause 2: Financials & Escrow -->
        <div class="clause-title">
            <span>البند الثاني: القيمة الإجمالية ونظام الضمان المالي المشترك (Escrow)</span>
        </div>
        <div class="clause-text">
            اتفق الطرفان على أن القيمة الإجمالية لتنفيذ الأعمال هي: <strong>@Model.TotalAmount.ToString("N0") ريال سعودي</strong> (غير شاملة ضريبة القيمة المضافة)، وتُضاف إليها ضريبة القيمة المضافة بنسبة (15%) وقدرها: <strong>@Model.TaxAmount.ToString("N0") ريال سعودي</strong>، ليصبح الإجمالي الشامل: <strong>@Model.TotalWithTax.ToString("N0") ريال سعودي</strong>.
        </div>
        <div class="clause-text bg-light p-3 rounded-2 border">
            <strong>نظام الضمان المالي المعتمد:</strong> يلتزم الطرف الأول (صاحب العمل) بإيداع مبالغ الدفعات في الحساب البنكي الرقمي المشترك (حساب الضمان - Escrow) عبر بوابة منصة "بُنيان"، ويظل المبلغ محفوظاً ومجمداً تحت مظلة الضمان، ولا يتم تحرير أو صرف أي دفعة للطرف الثاني إلا بعد إنجاز المرحلة الميدانية وإرفاق محاضر المعاينة وإقرار الطرف الأول بالاستلام والمطابقة الفنية.
        </div>

        <!-- Clause 3: Payment Milestones Schedule -->
        <div class="clause-title avoid-break">
            <span>البند الثالث: جدول المراحل التنفيذية والدفعات المالية</span>
        </div>
        <div class="avoid-break">
            <table class="schedule-table">
                <thead>
                    <tr>
                        <th style="width: 10%;">المرحلة</th>
                        <th style="width: 35%;">بيان المرحلة والأعمال المطلوب تسليمها</th>
                        <th style="width: 15%;">نسبة الإنجاز</th>
                        <th style="width: 20%;">المبلغ المستحق (ر.س)</th>
                        <th style="width: 20%;">حالة التأمين بالضمان</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Milestones)
                    {
                        <tr>
                            <td class="fw-bold text-center">#@m.OrderIndex</td>
                            <td>
                                <strong>@m.Title</strong>
                                @if (!string.IsNullOrEmpty(m.Description))
                                {
                                    <small class="text-muted d-block mt-1">@m.Description</small>
                                }
                            </td>
                            <td class="text-center">@m.Percentage%</td>
                            <td class="fw-bold font-monospace">@m.Amount.ToString("N0") ر.س</td>
                            <td>
                                @if (m.Status == MilestoneStatus.Paid)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check2-all me-1"></i> تم الصرف للمقاول</span>
                                }
                                else if (m.IsFundedInEscrow)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-lock-fill me-1"></i> مؤمن في الضمان</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">بانتظار إيداع الضمان</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Clause 4: Duration & Deadlines -->
        <div class="clause-title">
            <span>البند الرابع: مدة العقد والجدول الزمني وغرامات التأخير</span>
        </div>
        <div class="clause-text">
            يُحدد إجمالي المدة الزمنية لإنجاز المشروع بـ <strong>@Model.TotalDurationDays يوماً تقويمياً</strong>، تبدأ من تاريخ توقيع هذا العقد واستلام الموقع وتأمين الدفعة الأولى بالضمان. وفي حال تأخر الطرف الثاني عن إتمام الأعمال في الموعد المحدد لسبب يعود إليه ودون مبرر قاهر معتمد، يُفرض عليه غرامة تأخير قدرها (0.1%) من القيمة الإجمالية عن كل يوم تأخير بحد أقصى (10%) من إجمالي العقد، وتُخصم من مستحقاته المحتجزة بالضمان.
        </div>

        <!-- Clause 5: Technical Standards & Safety -->
        <div class="clause-title">
            <span>البند الخامس: الجودة والسلامة ومطابقة كود البناء السعودي</span>
        </div>
        <div class="clause-text">
            يلتزم الطرف الثاني بتطبيق أدق متطلبات كود البناء السعودي (Saudi Building Code)، واتباع كافة اشتراطات السلامة المهنية والبيئية في موقع العمل وحماية المنشآت المجاورة. ويتحمل المقاول كامل المسؤولية القانونية والفنية عن أي عيوب مصنعية أو إنشائية لمدة سنة كاملة من تاريخ الاستلام النهائي.
        </div>

        <!-- Clause 6: Dispute Resolution -->
        <div class="clause-title">
            <span>البند السادس: فض النزاعات والتسوية الودية</span>
        </div>
        <div class="clause-text">
            في حال نشوء أي خلاف حول تفسير أو تنفيذ هذا العقد أو محاضر الاستلام، يتم اللجوء أولاً إلى مركز التحكيم الهندسي وفض النزاعات التابع لمنصة "بُنيان" للتسوية الودية وحفظ حقوق الطرفين. وفي حال تعذر ذلك، تختص المحاكم التجارية بالمملكة العربية السعودية بالنظر في النزاع.
        </div>

        <!-- Signatures and Digital Verification Box -->
        <div class="clause-title avoid-break mt-5">
            <span>إقرار وتوقيع الطرفين والتوثيق الإلكتروني الرسمي</span>
        </div>

        <div class="row g-3 avoid-break mt-2">
            <!-- First Party Signature -->
            <div class="col-6">
                <div class="signature-box">
                    <h6 class="fw-bold text-dark mb-1">الطرف الأول (صاحب العمل)</h6>
                    <div class="small text-muted mb-3">@Model.ClientFullName</div>
                    <div class="seal-stamp mb-2" style="border-color: #0284c7; color: #0284c7;">
                        <i class="bi bi-patch-check-fill me-1"></i> توقيع رقمي معتمد
                    </div>
                    <div class="small text-muted font-monospace" style="font-size: 0.75rem;">
                        المطابقة: معتمد وموثق عبر منصة بُنيان<br/>
                        التاريخ: @Model.ContractDate.ToString("yyyy/MM/dd HH:mm")
                    </div>
                </div>
            </div>

            <!-- Second Party Signature -->
            <div class="col-6">
                <div class="signature-box">
                    <h6 class="fw-bold text-dark mb-1">الطرف الثاني (المقاول المنفذ)</h6>
                    <div class="small text-muted mb-3">@Model.ContractorCompanyName</div>
                    <div class="seal-stamp mb-2" style="border-color: #10b981; color: #10b981;">
                        <i class="bi bi-shield-check me-1"></i> الختم الإلكتروني للمنشأة
                    </div>
                    <div class="small text-muted font-monospace" style="font-size: 0.75rem;">
                        سجل تجاري: @Model.CommercialRegistrationNo<br/>
                        التاريخ: @Model.ContractDate.ToString("yyyy/MM/dd HH:mm")
                    </div>
                </div>
            </div>
        </div>

        <!-- Platform Verification Footer -->
        <div class="border-top pt-3 mt-4 text-center avoid-break">
            <div class="d-flex justify-content-between align-items-center text-muted small">
                <span>رمز الأمان والتوثيق: <strong class="font-monospace text-dark">@Model.VerificationSealCode</strong></span>
                <span>مرجع الضمان البنكي: <strong class="font-monospace text-dark">@Model.EscrowGuaranteeReference</strong></span>
                <span>الصفحة 1 من 1</span>
            </div>
            <p class="text-secondary mt-2 mb-0" style="font-size: 0.75rem;">
                هذه الوثيقة صادرة إلكترونياً ومحمية بنظام التشفير والضمان المالي لمنصة بُنيان لتقنية المقاولات، ولا تتطلب توقيعاً خطياً.
            </p>
        </div>

    </div>

</body>
</html>
