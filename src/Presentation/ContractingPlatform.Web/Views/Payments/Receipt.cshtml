@model ContractingPlatform.Application.DTOs.Payments.PaymentReceiptDto
@{
    ViewData["Title"] = "سند السداد وفاتورة الضمان الإلكترونية";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Action Bar (Hidden on Print) -->
            <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
                <a href="@Url.Action("Details", "Contracts", new { id = Model.ProjectContractId })" class="btn btn-outline-custom d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-right"></i>
                    <span>العودة لتفاصيل العقد</span>
                </a>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary-custom d-inline-flex align-items-center gap-2" onclick="window.print()">
                        <i class="bi bi-printer-fill"></i>
                        <span>طباعة السند / حفظ PDF</span>
                    </button>
                </div>
            </div>

            <!-- Printable Receipt Card -->
            <div class="card card-custom p-4 p-md-5 shadow-sm border bg-white receipt-container" id="printableReceipt">
                <!-- Receipt Header -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start border-bottom pb-4 mb-4 gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="rounded p-2 bg-primary text-white fs-4 fw-bold">بُ</span>
                            <h4 class="fw-bold text-dark mb-0">بُنيان | منصة المقاولات والخدمات الرقمية</h4>
                        </div>
                        <p class="text-muted small mb-0">سند قبض وإيداع مالي بحساب الضمان البنكي المشترك (Escrow Receipt)</p>
                        <small class="text-muted">الرقم الضريبي للمنصة: <strong>30098451200003</strong> | س.ت: <strong>1010786542</strong></small>
                    </div>

                    <div class="text-md-end">
                        <div class="p-2 border rounded-3 text-center bg-light mb-2">
                            <span class="small text-muted d-block" style="font-size: 0.75rem;">الرقم المرجعي للمعاملة</span>
                            <strong class="font-monospace text-primary fs-6">@Model.TransactionReference</strong>
                        </div>
                        <small class="text-muted d-block">التاريخ: @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd hh:mm tt")</small>
                    </div>
                </div>

                <!-- Status Badge Banner -->
                <div class="p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center @(Model.PaymentStatus == ContractingPlatform.Domain.Enums.PaymentStatus.HeldInEscrow ? "bg-success bg-opacity-10 border border-success" : "bg-primary bg-opacity-10 border border-primary")">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(Model.PaymentStatus == ContractingPlatform.Domain.Enums.PaymentStatus.HeldInEscrow ? "bi-shield-check text-success" : "bi-check-circle text-primary") fs-4"></i>
                        <div>
                            <strong class="@(Model.PaymentStatus == ContractingPlatform.Domain.Enums.PaymentStatus.HeldInEscrow ? "text-success" : "text-primary") d-block">
                                @(Model.PaymentStatus == ContractingPlatform.Domain.Enums.PaymentStatus.HeldInEscrow ? "المبلغ محجوز ومؤمن بحساب الضمان البنكي" : "تم الإفراج عن الدفعة وصرفها للمقاول")
                            </strong>
                            <small class="text-muted">طريقة السداد: @Model.PaymentMethod</small>
                        </div>
                    </div>
                    <span class="badge @(Model.PaymentStatus == ContractingPlatform.Domain.Enums.PaymentStatus.HeldInEscrow ? "bg-success" : "bg-primary") text-white px-3 py-2 fs-6">
                        @(Model.PaymentStatus == ContractingPlatform.Domain.Enums.PaymentStatus.HeldInEscrow ? "مضمون بنكياً" : "مصروف ومعتمد")
                    </span>
                </div>

                <!-- Contracting Parties Grid -->
                <div class="row g-4 mb-4 pb-4 border-bottom">
                    <div class="col-md-6 border-start-md">
                        <span class="text-muted small d-block mb-1">الطرف الأول (العميل المسدد)</span>
                        <h6 class="fw-bold text-dark mb-1">@Model.ClientName</h6>
                        <small class="text-muted d-block">الهاتف: @Model.ClientPhone</small>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted small d-block mb-1">الطرف الثاني (المقاول المنفذ)</span>
                        <h6 class="fw-bold text-dark mb-1">@Model.ContractorCompanyName</h6>
                        <small class="text-muted d-block">السجل التجاري: @Model.ContractorCrNumber</small>
                    </div>
                </div>

                <!-- Contract & Milestone Details Table -->
                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">بيان الأعمال التعاقدية والمرحلة</th>
                                <th class="py-3 text-center" style="width: 130px;">رقم العقد</th>
                                <th class="py-3 text-end" style="width: 180px;">المبلغ (ر.س)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">@Model.ProjectTitle</strong>
                                    <span class="text-primary small fw-medium">المرحلة: @Model.MilestoneTitle</span>
                                </td>
                                <td class="text-center font-monospace">#@Model.ProjectContractId</td>
                                <td class="text-end fw-bold text-dark">@Model.BaseAmount.ToString("N2")</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="text-end text-muted small">رسوم خدمة الضمان البنكي والتحكيم (5%):</td>
                                <td class="text-end small">@Model.PlatformFee.ToString("N2") ر.س</td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-end text-muted small">ضريبة القيمة المضافة (15% على الرسوم):</td>
                                <td class="text-end small">@Model.VatAmount.ToString("N2") ر.س</td>
                            </tr>
                            <tr class="table-light">
                                <td colspan="2" class="text-end fw-bold text-dark fs-6">إجمالي المبلغ المودع في الضمان:</td>
                                <td class="text-end fw-extrabold text-primary fs-5">@Model.TotalAmount.ToString("N2") ر.س</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Footer with QR Simulation & Escrow Terms -->
                <div class="row align-items-center pt-3 mt-2 border-top">
                    <div class="col-md-8">
                        <h6 class="fw-bold text-dark mb-1 small">شروط وضمانات حساب الوساطة المالي:</h6>
                        <p class="text-muted small mb-0 leading-relaxed" style="font-size: 0.78rem;">
                            هذا الإيصال صادر إلكترونياً من منصة "بُنيان" ويوثق استلام وتأمين المبلغ المذكور في حساب بنكي وسيط مستقل. لا يتم تحرير وصرف المبلغ للمقاول إلا بعد مصادقة العميل الميدانية على إتمام المرحلة وفق المواصفات الهندسية المعتمدة.
                        </p>
                    </div>
                    <div class="col-md-4 text-center text-md-end mt-3 mt-md-0">
                        <!-- Digital Verification Stamp & QR Mock -->
                        <div class="d-inline-block p-2 border rounded-3 bg-light text-center">
                            <div class="rounded bg-white p-2 border mb-1" style="width: 80px; height: 80px; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="bi bi-qr-code fs-1 text-dark"></i>
                            </div>
                            <span class="d-block text-muted" style="font-size: 0.65rem;">تحقق إلكتروني معتمد</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    @@media print {
        body {
            background-color: #fff !important;
        }
        header, footer, .d-print-none {
            display: none !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }
        .receipt-container {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>
}
