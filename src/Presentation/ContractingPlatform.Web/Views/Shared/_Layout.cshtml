@using ContractingPlatform.Domain.Enums
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بُنيان | منصة المقاولات والخدمات المنزلية</title>
    
    <!-- Google Cairo Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --primary-color: #0f3460;
            --primary-hover: #16213e;
            --accent-color: #e94560;
            --accent-gold: #f39c12;
            --bg-light: #f8fafc;
            --text-dark: #1e293b;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background-color: #ffffff;
            box-shadow: 0 2px 15px rgba(0,0,0,0.06);
            padding: 0.8rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary-color) !important;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .navbar-brand i {
            color: var(--accent-gold);
        }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            padding: 0.5rem 1rem !important;
            transition: all 0.2s ease-in-out;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--primary-color) !important;
        }

        .btn-primary-custom {
            background-color: var(--primary-color);
            color: #fff;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.55rem 1.3rem;
            border: none;
            transition: all 0.2s;
        }

        .btn-primary-custom:hover {
            background-color: var(--primary-hover);
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-accent {
            background-color: var(--accent-gold);
            color: #fff;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.55rem 1.3rem;
            border: none;
        }

        .btn-accent:hover {
            background-color: #d68910;
            color: #fff;
        }

        .card-custom {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            background: #fff;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card-custom:hover {
            box-shadow: 0 6px 25px rgba(0,0,0,0.08);
        }

        .badge-status {
            font-size: 0.82rem;
            padding: 0.4em 0.8em;
            border-radius: 6px;
            font-weight: 600;
        }

        .footer {
            background-color: #0d1b2a;
            color: #cbd5e1;
            margin-top: auto;
            padding: 2.5rem 0 1.5rem 0;
        }

        .footer a {
            color: #94a3b8;
            text-decoration: none;
        }

        .footer a:hover {
            color: #fff;
        }

        .hero-banner {
            background: linear-gradient(135deg, #0f3460 0%, #16213e 100%);
            color: white;
            padding: 4.5rem 0 3.5rem 0;
            border-radius: 0 0 25px 25px;
            margin-bottom: 2.5rem;
        }
    </style>
</head>
<body>
    <!-- Main Header / Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-tools fs-3"></i>
                    <span>بُنيان</span>
                    <small class="text-muted fs-6 fw-normal d-none d-md-inline">| منصة المقاولات والصيانة</small>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Projects" asp-action="Index">
                                <i class="bi bi-briefcase me-1"></i> تصفح المشاريع
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(nameof(UserType.Client)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="Projects" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i> طرح مشروع جديد
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="MyProjects">مشاريعي</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Contracts" asp-action="MyContracts">العقود والدفعات</a>
                                </li>
                            }
                            else if (User.IsInRole(nameof(UserType.Contractor)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Bids" asp-action="MyBids">
                                        <i class="bi bi-send-check me-1"></i> عروضي المقدمة
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Contracts" asp-action="MyContracts">
                                        <i class="bi bi-clipboard-check me-1"></i> المشاريع التنفيذية
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(nameof(UserType.Admin)))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock me-1"></i> لوحة الإدارة
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">الإحصائيات والتحليلات</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Contractors">توثيق وفحص المقاولين</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Projects">مراقبة كافة المشاريع</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    
                    <!-- Auth Section -->
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span>@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li class="dropdown-header">الدور: @(User.IsInRole("Admin") ? "مدير النظام" : User.IsInRole("Contractor") ? "مقدم خدمة / مقاول" : "عميل")</li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-1"></i> تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                            <div class="dropdown">
                                <button class="btn btn-primary-custom dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    حساب جديد
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="RegisterClient"><i class="bi bi-person me-2"></i> حساب عميل (أفراد وشركات)</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="RegisterContractor"><i class="bi bi-tools me-2"></i> حساب منشأة مقاولات / فني</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Alert Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Body Container -->
    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-tools text-warning me-2"></i>منصة بُنيان</h5>
                    <p class="small text-muted">المنصة الرقمية المتكاملة في قطاع المقاولات والتشطيب والخدمات المنزلية، نضمن لك التعاقد الآمن، مراحل التنفيذ الدقيقة، ونظام الدفعات المجمدة لحماية حقوق الجميع.</p>
                </div>
                <div class="col-lg-2 col-md-4">
                    <h6 class="text-white fw-bold mb-3">روابط سريعة</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Projects" asp-action="Index">المشاريع المتاحة</a></li>
                        <li><a asp-controller="Account" asp-action="RegisterContractor">انضم كشريك مقاول</a></li>
                        <li><a asp-controller="Account" asp-action="RegisterClient">طلب تسعير مجاني</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h6 class="text-white fw-bold mb-3">حسابات تجريبية للاختبار</h6>
                    <ul class="list-unstyled small text-muted d-flex flex-column gap-1">
                        <li><strong>المدير:</strong> admin@contracting.com</li>
                        <li><strong>المقاول:</strong> contractor@builder.com</li>
                        <li><strong>العميل:</strong> client@home.com</li>
                        <li class="mt-1 text-warning">كلمة المرور موحدة: <code>Admin@123456</code> / <code>Contractor@123456</code> / <code>Client@123456</code></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <h6 class="text-white fw-bold mb-3">الضمان والأمان</h6>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-success fs-4"></i>
                        <span class="small">عقود إلكترونية موثقة وحماية كاملة للدفعات</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-patch-check text-primary fs-4"></i>
                        <span class="small">مقاولون مفحوصون بالسجل التجاري المعتمد</span>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center small text-muted">
                جميع الحقوق محفوظة &copy; @DateTime.UtcNow.Year - منصة بُنيان للخدمات الرقمية والمقاولات (.NET 10 Clean Architecture)
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // Setup SignalR Real-time notification listener
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/platform")
            .withAutomaticReconnect()
            .build();

        connection.start().then(function () {
            console.log("SignalR Connected to Bunyan Platform Hub.");
        }).catch(function (err) {
            console.warn("SignalR connection skipped or user anonymous:", err.toString());
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
