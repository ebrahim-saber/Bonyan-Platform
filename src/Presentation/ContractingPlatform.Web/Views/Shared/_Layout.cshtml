@using ContractingPlatform.Domain.Enums
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بُنيان | منصة المقاولات والتشطيب الذكية</title>
    
    <!-- Google Cairo & Readex Pro Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Readex+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 RTL & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Modern Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Header / Navigation -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-wrapper">
                        <i class="bi bi-hammer fs-4"></i>
                    </div>
                    <div>
                        <span class="fw-bold tracking-tight">بُنيان</span>
                        <small class="text-muted d-block fw-normal" style="font-size: 0.72rem; margin-top: -4px;">منصة المقاولات والتشطيب</small>
                    </div>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> الرئيسية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Projects" asp-action="Index">
                                <i class="bi bi-briefcase me-1"></i> تصفح المشاريع
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contractors" asp-action="Index">
                                <i class="bi bi-person-badge me-1"></i> دليل المقاولين
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(nameof(UserType.Client)))
                            {
                                <li class="nav-item ms-lg-2">
                                    <a class="btn btn-sm btn-accent text-white px-3 fw-bold" asp-controller="Projects" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i> طرح مشروع جديد
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="MyProjects">مشاريعي</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Contracts" asp-action="MyContracts">العقود والدفعات</a>
                                </li>
                            }
                            else if (User.IsInRole(nameof(UserType.Contractor)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Bids" asp-action="MyBids">
                                        <i class="bi bi-send-check me-1"></i> عروضي المقدمة
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Contracts" asp-action="MyContracts">
                                        <i class="bi bi-clipboard-check me-1"></i> المشاريع التنفيذية
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(nameof(UserType.Admin)))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock me-1"></i> لوحة الإدارة
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0 mt-2">
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> الإحصائيات والتحليلات</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Finances"><i class="bi bi-bank2 me-2 text-success"></i> الرقابة المالية والضمان (Escrow)</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Contractors"><i class="bi bi-patch-check me-2"></i> توثيق وفحص المقاولين</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Projects"><i class="bi bi-kanban me-2"></i> مراقبة كافة المشاريع</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    
                    <!-- Auth Section -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Direct Chat Link -->
                            <a class="btn btn-outline-custom position-relative p-2" asp-controller="Messages" asp-action="Index" title="المحادثات الميدانية">
                                <i class="bi bi-chat-dots fs-5 text-primary"></i>
                            </a>

                            <!-- Real-time Notifications Bell -->
                            <div class="dropdown">
                                <button class="btn btn-outline-custom position-relative p-2" type="button" id="notificationsDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="التنبيهات">
                                    <i class="bi bi-bell fs-5 text-primary"></i>
                                    <span id="navUnreadBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0" style="width: 330px; max-width: 90vw;">
                                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light bg-opacity-50">
                                        <h6 class="fw-bold mb-0 text-dark">التنبيهات الفورية</h6>
                                        <button type="button" class="btn btn-link btn-sm text-primary text-decoration-none p-0 small" onclick="markAllNotificationsRead(event)">تحديد الكل كمقروء</button>
                                    </div>
                                    <div id="navNotificationsContainer" class="overflow-auto" style="max-height: 320px;">
                                        <div class="p-3 text-center text-muted small" id="navNotificationsLoading">جاري التحميل...</div>
                                    </div>
                                    <div class="p-2 border-top text-center bg-light bg-opacity-25">
                                        <a asp-controller="Notifications" asp-action="Index" class="btn btn-link btn-sm text-primary text-decoration-none fw-bold small">عرض كافة الإشعارات</a>
                                    </div>
                                </div>
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-outline-custom dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span class="small fw-bold">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li class="dropdown-header small text-muted">
                                        الحساب: @(User.IsInRole("Admin") ? "مدير النظام العام" : User.IsInRole("Contractor") ? "منشأة مقاولات / فني" : "عميل")
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-custom" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                            <div class="dropdown">
                                <button class="btn btn-primary-custom dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    انضم إلينا
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="RegisterClient"><i class="bi bi-person me-2 text-primary"></i> حساب عميل (أفراد وشركات)</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="RegisterContractor"><i class="bi bi-tools me-2 text-warning"></i> تسجيل منشأة مقاولات / فني</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 rounded-3" role="alert">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Modern Dark Footer -->
    <footer style="background-color: #0b132b; color: #94a3b8;" class="pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-wrapper" style="width: 36px; height: 36px;">
                            <i class="bi bi-hammer text-warning fs-5"></i>
                        </div>
                        <span class="fs-4 fw-bold text-white">بُنيان</span>
                    </div>
                    <p class="small text-secondary leading-relaxed">
                        المنصة الرقمية المتكاملة لحلول المقاولات، التشطيب، والخدمات المنزلية في المملكة العربية السعودية. نضمن حقوقك عبر نظام التعاقد الموثق والدفعات المحمية (Escrow) والرقابة الهندسية.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <span class="badge bg-dark border border-secondary text-light px-3 py-2"><i class="bi bi-shield-check text-success me-1"></i> كود البناء السعودي</span>
                        <span class="badge bg-dark border border-secondary text-light px-3 py-2"><i class="bi bi-lock text-warning me-1"></i> دفعات مجمدة آمنة</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4">
                    <h6 class="text-white fw-bold mb-3">خدمات المنصة</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="/Projects?categoryId=1" class="text-decoration-none text-secondary">تشطيب وبناء متكامل</a></li>
                        <li><a href="/Projects?categoryId=2" class="text-decoration-none text-secondary">أعمال الكهرباء والإنارة</a></li>
                        <li><a href="/Projects?categoryId=3" class="text-decoration-none text-secondary">السباكة والصرف الصحي</a></li>
                        <li><a href="/Projects?categoryId=4" class="text-decoration-none text-secondary">التكييف والتهوية</a></li>
                        <li><a href="/Projects?categoryId=5" class="text-decoration-none text-secondary">الدهانات والديكورات</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-4">
                    <h6 class="text-white fw-bold mb-3">بيانات الدخول السريعة للاختبار</h6>
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 border border-secondary border-opacity-25 small">
                        <div class="mb-1 text-light"><strong>المدير:</strong> <code>admin@contracting.com</code></div>
                        <div class="mb-1 text-light"><strong>المقاول:</strong> <code>contractor@builder.com</code></div>
                        <div class="mb-2 text-light"><strong>العميل:</strong> <code>client@home.com</code></div>
                        <span class="badge bg-warning text-dark">كلمة المرور موحدة: Admin@123456</span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4">
                    <h6 class="text-white fw-bold mb-3">الضمان والاعتماد</h6>
                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-patch-check-fill text-success fs-5"></i>
                            <div>
                                <strong class="text-white d-block">توثيق السجل التجاري (CR)</strong>
                                <span class="text-muted">مراجعة يدوية وتدقيق للتراخيص الرسمية لكل منشأة قبل اعتمادها.</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-wallet2 text-warning fs-5"></i>
                            <div>
                                <strong class="text-white d-block">حساب الضمان المالي المشترك</strong>
                                <span class="text-muted">أموالك محفوظة في حساب بنكي وسيط ولا يتم الصرف إلا بموافقتك.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <div>جميع الحقوق محفوظة &copy; @DateTime.UtcNow.Year - منصة بُنيان للخدمات الرقمية والمقاولات (.NET 10 Clean Architecture)</div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a href="#" class="text-secondary text-decoration-none">سياسة الخصوصية</a>
                    <a href="#" class="text-secondary text-decoration-none">الشروط والأحكام</a>
                    <a href="#" class="text-secondary text-decoration-none">مركز الدعم</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Real-time Toast Notifications Container -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1090;" id="toastNotificationContainer"></div>

    <!-- Bootstrap 5 & SignalR Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // Setup SignalR Real-time Hub Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/platform")
            .withAutomaticReconnect()
            .build();

        connection.start().then(function () {
            console.log("SignalR Connected to Bunyan Platform Hub.");
        }).catch(function (err) {
            console.warn("SignalR connection skipped or user anonymous:", err.toString());
        });

        // Real-time Notification Event Handler
        connection.on("ReceiveNotification", function (notification) {
            showToastNotification(notification);
            updateNavBadgeIncrement();
            prependNavNotification(notification);
        });

        function showToastNotification(n) {
            const container = document.getElementById("toastNotificationContainer");
            if (!container) return;

            const toastEl = document.createElement("div");
            toastEl.className = "toast show shadow border bg-white mb-2";
            toastEl.setAttribute("role", "alert");
            toastEl.innerHTML = `
                <div class="toast-header bg-primary text-white d-flex justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bell-fill"></i>
                        <strong class="me-auto">${escapeHtml(n.title)}</strong>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body">
                    <p class="mb-2 text-dark small">${escapeHtml(n.message)}</p>
                    ${n.actionUrl ? `<a href="${n.actionUrl}" class="btn btn-sm btn-primary-custom py-1 px-3 d-inline-flex align-items-center gap-1"><span>معاينة</span><i class="bi bi-arrow-left"></i></a>` : ''}
                </div>
            `;
            container.appendChild(toastEl);
            setTimeout(() => {
                toastEl.classList.remove("show");
                setTimeout(() => toastEl.remove(), 500);
            }, 7000);
        }

        function updateNavBadgeIncrement() {
            const badge = document.getElementById("navUnreadBadge");
            if (badge) {
                let current = parseInt(badge.textContent) || 0;
                current++;
                badge.textContent = current;
                badge.classList.remove("d-none");
            }
        }

        function prependNavNotification(n) {
            const container = document.getElementById("navNotificationsContainer");
            if (!container) return;

            const loading = document.getElementById("navNotificationsLoading");
            if (loading) loading.remove();

            const item = document.createElement("a");
            item.href = n.actionUrl || "/Notifications";
            item.className = "dropdown-item p-3 border-bottom d-flex align-items-start gap-2 bg-light bg-opacity-75";
            item.innerHTML = `
                <i class="bi bi-bell text-primary fs-5 mt-1 flex-shrink-0"></i>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="d-block text-dark text-truncate small">${escapeHtml(n.title)}</strong>
                        <span class="badge bg-primary text-white" style="font-size: 0.6rem;">الآن</span>
                    </div>
                    <small class="text-muted d-block text-truncate" style="max-width: 240px;">${escapeHtml(n.message)}</small>
                </div>
            `;
            container.insertBefore(item, container.firstChild);
        }

        function loadNotificationsSummary() {
            const container = document.getElementById("navNotificationsContainer");
            const badge = document.getElementById("navUnreadBadge");
            if (!container || !badge) return;

            fetch('/Notifications/GetUnreadSummary')
                .then(res => res.json())
                .then(data => {
                    if (data.unreadCount > 0) {
                        badge.textContent = data.unreadCount;
                        badge.classList.remove("d-none");
                    } else {
                        badge.textContent = "0";
                        badge.classList.add("d-none");
                    }

                    container.innerHTML = "";
                    if (!data.recentNotifications || data.recentNotifications.length === 0) {
                        container.innerHTML = '<div class="p-3 text-center text-muted small">لا توجد إشعارات جديدة</div>';
                    } else {
                        data.recentNotifications.forEach(n => {
                            const item = document.createElement("a");
                            item.href = n.actionUrl || "/Notifications";
                            item.className = `dropdown-item p-3 border-bottom d-flex align-items-start gap-2 ${!n.isRead ? 'bg-light bg-opacity-75' : ''}`;
                            item.innerHTML = `
                                <i class="bi bi-bell ${!n.isRead ? 'text-primary' : 'text-muted'} fs-5 mt-1 flex-shrink-0"></i>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="d-block text-dark text-truncate small">${escapeHtml(n.title)}</strong>
                                        <small class="text-muted" style="font-size: 0.65rem;">${n.timeAgo}</small>
                                    </div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 240px;">${escapeHtml(n.message)}</small>
                                </div>
                            `;
                            container.appendChild(item);
                        });
                    }
                })
                .catch(err => console.error(err));
        }

        function markAllNotificationsRead(e) {
            e.stopPropagation();
            fetch('/Notifications/MarkAllAsRead', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const badge = document.getElementById("navUnreadBadge");
                    if (badge) {
                        badge.textContent = "0";
                        badge.classList.add("d-none");
                    }
                    const container = document.getElementById("navNotificationsContainer");
                    if (container) {
                        container.querySelectorAll(".bg-light").forEach(el => el.classList.remove("bg-light", "bg-opacity-75"));
                    }
                }
            })
            .catch(err => console.error(err));
        }

        function escapeHtml(text) {
            if (!text) return "";
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        // Initialize on page load for authenticated users
        document.addEventListener("DOMContentLoaded", function () {
            if (document.getElementById("navUnreadBadge")) {
                loadNotificationsSummary();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
