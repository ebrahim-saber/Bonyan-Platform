@using ContractingPlatform.Domain.Enums
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بُنيان | منصة المقاولات والتشطيب الذكية</title>
    
    <!-- Google Cairo & Readex Pro Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Readex+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 RTL & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Modern Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Header / Navigation -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-3 py-1" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-wrapper">
                        <i class="bi bi-buildings-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-extrabold tracking-tight fs-3" style="line-height: 1;">بُنيان</span>
                            <span class="badge bg-warning text-dark small fw-bold px-2 py-0 rounded-pill" style="font-size: 0.65rem;">منصة معتمدة</span>
                        </div>
                        <small class="text-muted d-block fw-semibold" style="font-size: 0.72rem; margin-top: 1px;">المنظومة السعودية للتعاقد والضمان الإنشائي</small>
                    </div>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 d-inline-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill text-primary small"></i>
                                <span>الرئيسية</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 d-inline-flex align-items-center gap-2" asp-controller="Projects" asp-action="Index">
                                <i class="bi bi-kanban-fill text-warning small"></i>
                                <span>تصفح المشاريع</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 d-inline-flex align-items-center gap-2" asp-controller="Contractors" asp-action="Index">
                                <i class="bi bi-patch-check-fill text-success small"></i>
                                <span>دليل المقاولين</span>
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(nameof(UserType.Client)))
                            {
                                <li class="nav-item ms-lg-2">
                                    <a class="btn btn-sm btn-accent text-white px-3 py-2 fw-bold shadow-gold d-inline-flex align-items-center gap-2" asp-controller="Projects" asp-action="Create">
                                        <i class="bi bi-plus-circle-fill"></i>
                                        <span>طرح مشروع جديد</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Projects" asp-action="MyProjects">مشاريعي</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Contracts" asp-action="MyContracts">العقود والدفعات</a>
                                </li>
                            }
                            else if (User.IsInRole(nameof(UserType.Contractor)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Bids" asp-action="MyBids">
                                        <i class="bi bi-send-check me-1"></i> عروضي المقدمة
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Contracts" asp-action="MyContracts">
                                        <i class="bi bi-clipboard-check me-1"></i> المشاريع التنفيذية
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(nameof(UserType.Admin)))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-lock me-1"></i> لوحة الإدارة
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0 mt-2">
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> الإحصائيات والتحليلات</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Finances"><i class="bi bi-bank2 me-2 text-success"></i> الرقابة المالية والضمان (Escrow)</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Contractors"><i class="bi bi-patch-check me-2"></i> توثيق وفحص المقاولين</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Projects"><i class="bi bi-kanban me-2"></i> مراقبة كافة المشاريع</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    
                    <!-- Auth Section -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Direct Chat Link -->
                            <a class="btn btn-outline-custom position-relative p-2" asp-controller="Messages" asp-action="Index" title="المحادثات الميدانية">
                                <i class="bi bi-chat-dots fs-5 text-primary"></i>
                            </a>

                            <!-- Real-time Notifications Bell -->
                            <div class="dropdown">
                                <button class="btn btn-outline-custom position-relative p-2" type="button" id="notificationsDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="التنبيهات">
                                    <i class="bi bi-bell fs-5 text-primary"></i>
                                    <span id="navUnreadBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0" style="width: 330px; max-width: 90vw;">
                                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light bg-opacity-50">
                                        <h6 class="fw-bold mb-0 text-dark">التنبيهات الفورية</h6>
                                        <button type="button" class="btn btn-link btn-sm text-primary text-decoration-none p-0 small" onclick="markAllNotificationsRead(event)">تحديد الكل كمقروء</button>
                                    </div>
                                    <div id="navNotificationsContainer" class="overflow-auto" style="max-height: 320px;">
                                        <div class="p-3 text-center text-muted small" id="navNotificationsLoading">جاري التحميل...</div>
                                    </div>
                                    <div class="p-2 border-top text-center bg-light bg-opacity-25">
                                        <a asp-controller="Notifications" asp-action="Index" class="btn btn-link btn-sm text-primary text-decoration-none fw-bold small">عرض كافة الإشعارات</a>
                                    </div>
                                </div>
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-outline-custom dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span class="small fw-bold">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li class="dropdown-header small text-muted">
                                        الحساب: @(User.IsInRole("Admin") ? "مدير النظام العام" : User.IsInRole("Contractor") ? "منشأة مقاولات / فني" : "عميل")
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-custom px-3 py-2 fw-bold d-inline-flex align-items-center gap-2" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-left fs-6 text-primary"></i>
                                <span>تسجيل الدخول</span>
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-accent px-3 py-2 fw-bold shadow-gold dropdown-toggle d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-plus-fill"></i>
                                    <span>انضم للمنصة</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-2" style="min-width: 250px; border-radius: 14px;">
                                    <li>
                                        <a class="dropdown-item p-2 rounded-3 d-flex align-items-center gap-3" asp-controller="Account" asp-action="RegisterClient">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                                <i class="bi bi-person-fill fs-5"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark small">حساب صاحب عمل (عميل)</strong>
                                                <small class="text-muted" style="font-size: 0.72rem;">طرح مشاريعك وتأمين دفعاتك بالضمان</small>
                                            </div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item p-2 rounded-3 d-flex align-items-center gap-3" asp-controller="Account" asp-action="RegisterContractor">
                                            <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                                <i class="bi bi-tools fs-5"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark small">منشأة مقاولات معتمدة</strong>
                                                <small class="text-muted" style="font-size: 0.72rem;">تقديم عروض الأسعار والاعتماد الرسمي</small>
                                            </div>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 rounded-3" role="alert">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- ==========================================================================
         Pre-Footer Call-To-Action Ribbon
         ========================================================================== -->
    <section class="py-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-top: 1px solid rgba(255,255,255,0.08);">
        <div class="container">
            <div class="row align-items-center justify-content-between g-4">
                <div class="col-lg-8 text-start text-white">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3);">
                        <span class="pulse-dot"></span>
                        <span class="small text-warning fw-bold">ابدأ رحلة البناء اليوم</span>
                    </div>
                    <h3 class="fw-extrabold mb-2 text-white" style="letter-spacing: -0.02em;">جاهز لتنفيذ مشروعك القادم بأعلى درجات الأمان المالي؟</h3>
                    <p class="text-white-50 mb-0" style="font-size: 1.05rem; line-height: 1.7;">انضم إلى آلاف الملاك والمقاولين في منصة بُنيان، واستمتع بعقود موثقة وحساب ضمان بنكي يحمي كل ريـال.</p>
                </div>
                <div class="col-lg-4 text-lg-end text-start">
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <a asp-controller="Projects" asp-action="Create" class="btn btn-accent px-4 py-3 fw-bold d-inline-flex align-items-center gap-2 shadow-gold" style="border-radius: 12px; font-size: 1rem;">
                            <i class="bi bi-plus-circle-fill fs-5"></i>
                            <span>اطرح مشروعك مجاناً</span>
                        </a>
                        <a asp-controller="Contractors" asp-action="Index" class="btn btn-outline-light px-4 py-3 fw-bold d-inline-flex align-items-center gap-2" style="border-radius: 12px; font-size: 1rem; border-color: rgba(255,255,255,0.25);">
                            <i class="bi bi-building"></i>
                            <span>تصفح المقاولين</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         Luxury 4-Column Enterprise Footer
         ========================================================================== -->
    <footer style="background-color: #080e1e; color: #94a3b8;" class="pt-5 pb-4">
        <div class="container">
            <div class="row g-4 mb-5">
                <!-- Col 1: Identity, Mission & Trust Badges -->
                <div class="col-lg-4 col-md-12 text-start">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-wrapper" style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);">
                            <i class="bi bi-hammer text-dark fs-4"></i>
                        </div>
                        <div>
                            <span class="fs-4 fw-extrabold text-white d-block" style="line-height: 1.1; letter-spacing: -0.02em;">بُنيان</span>
                            <span class="text-white-50 small" style="font-size: 0.76rem; letter-spacing: 0.05em;">BUNYAN PLATFORM</span>
                        </div>
                    </div>
                    <p class="small text-secondary leading-relaxed mb-4" style="line-height: 1.8; max-width: 380px;">
                        المنصة الرقمية الرائدة لحوكمة مشاريع المقاولات والتشطيب في المملكة العربية السعودية. نوفر بيئة هندسية متكاملة تضمن الشفافية، حماية الدفعات عبر نظام الضمان المشترك (Escrow)، والالتزام التام بكود البناء السعودي.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge px-3 py-2 text-white" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3);">
                            <i class="bi bi-shield-check text-success me-1"></i> متوافق مع كود البناء السعودي
                        </span>
                        <span class="badge px-3 py-2 text-white" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3);">
                            <i class="bi bi-lock-fill text-warning me-1"></i> حساب الضمان المشترك (Escrow)
                        </span>
                    </div>
                </div>

                <!-- Col 2: Specialty Trades -->
                <div class="col-lg-2 col-md-4 col-sm-6 text-start">
                    <h6 class="text-white fw-bold mb-3 pb-2 position-relative" style="font-size: 0.98rem;">
                        قطاعات المقاولات
                        <span style="position: absolute; bottom: 0; right: 0; width: 28px; height: 2px; background: #f59e0b; border-radius: 2px;"></span>
                    </h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="/Projects?categoryId=1" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> تشطيب وبناء متكامل</a></li>
                        <li><a href="/Projects?categoryId=2" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> تمديدات كهربائية وإنارة</a></li>
                        <li><a href="/Projects?categoryId=3" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> سباكة وصرف صحي</a></li>
                        <li><a href="/Projects?categoryId=4" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> تكييف وتهوية مركزية</a></li>
                        <li><a href="/Projects?categoryId=5" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> دهانات وديكورات حديثة</a></li>
                        <li><a href="/Projects?categoryId=6" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> عزل مائي وحراري</a></li>
                    </ul>
                </div>

                <!-- Col 3: Quick Links & Protection -->
                <div class="col-lg-3 col-md-4 col-sm-6 text-start">
                    <h6 class="text-white fw-bold mb-3 pb-2 position-relative" style="font-size: 0.98rem;">
                        الضمان وحماية المستفيدين
                        <span style="position: absolute; bottom: 0; right: 0; width: 28px; height: 2px; background: #f59e0b; border-radius: 2px;"></span>
                    </h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a href="/Home/HowItWorks" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> كيف تعمل منصة بُنيان؟</a></li>
                        <li><a href="/Home/EscrowProtection" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> حماية الدفعات المالية (Escrow)</a></li>
                        <li><a href="/Home/ContractorVerification" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> معايير اعتماد وتأهيل المقاولين</a></li>
                        <li><a href="/Home/Estimator" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> حاسبة تكاليف التشطيب الذكية</a></li>
                        <li><a href="/Home/Terms" class="footer-link text-decoration-none"><i class="bi bi-chevron-left small ms-1 text-warning"></i> نموذج العقد الإنشائي الإلكتروني</a></li>
                    </ul>
                </div>

                <!-- Col 4: Trust Verification & Official Contacts -->
                <div class="col-lg-3 col-md-4 col-sm-12 text-start">
                    <h6 class="text-white fw-bold mb-3 pb-2 position-relative" style="font-size: 0.98rem;">
                        مركز الاتصال والمساعدة
                        <span style="position: absolute; bottom: 0; right: 0; width: 28px; height: 2px; background: #f59e0b; border-radius: 2px;"></span>
                    </h6>
                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block small" style="font-size: 0.78rem;">مركز خدمة العملاء 24/7</span>
                                <strong class="text-white" dir="ltr">+966 11 400 9090</strong>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block small" style="font-size: 0.78rem;">الاستفسارات والدعم التقني</span>
                                <strong class="text-white">support@bunyan-sa.com</strong>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <a href="#" class="btn btn-sm btn-dark border border-secondary border-opacity-25 text-light" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px;" title="X (Twitter)"><i class="bi bi-twitter-x"></i></a>
                            <a href="#" class="btn btn-sm btn-dark border border-secondary border-opacity-25 text-light" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px;" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                            <a href="#" class="btn btn-sm btn-dark border border-secondary border-opacity-25 text-light" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px;" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-warning ms-auto d-inline-flex align-items-center gap-1 px-2" data-bs-toggle="modal" data-bs-target="#demoAccountsModal" style="border-radius: 8px; font-size: 0.78rem;" title="حسابات التجربة">
                                <i class="bi bi-key-fill"></i>
                                <span>حسابات التجربة</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4">

            <!-- Sub-Footer Copyright & Signature -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 small text-secondary">
                <div class="text-center text-md-start">
                    <div>جميع الحقوق محفوظة &copy; @DateTime.UtcNow.Year - منصة <strong class="text-white">بُنيان</strong> للخدمات الإنشائية والتقنية المتقدمة.</div>
                    <div class="text-muted mt-1" style="font-size: 0.8rem;">
                        تم التصميم والتطوير المعماري بواسطة: <span class="text-warning fw-bold">المهندس / إبراهيم صابر (Eng. Ebrahim Saber)</span>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-end">
                    <a href="#" class="footer-link text-decoration-none">سياسة الخصوصية</a>
                    <span class="text-muted">•</span>
                    <a href="#" class="footer-link text-decoration-none">الشروط والأحكام</a>
                    <span class="text-muted">•</span>
                    <a href="#" class="footer-link text-decoration-none">معايير الأمان المالي</a>
                    <span class="text-muted">•</span>
                    <a href="#" class="footer-link text-decoration-none">مركز المساعدة</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ==========================================================================
         Demo Accounts Quick Assistant Modal (Clean Developer Tool)
         ========================================================================== -->
    <div class="modal fade" id="demoAccountsModal" tabindex="-1" aria-labelledby="demoAccountsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #0b132b 0%, #1c2541 100%); border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-key-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0" id="demoAccountsModalLabel">بيانات الدخول التجريبية</h5>
                            <span class="text-white-50 small" style="font-size: 0.78rem;">حسابات اختبار جاهزة لمحاكاة أدوار المنصة</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-warning d-flex align-items-center gap-2 py-2 px-3 mb-3 small" style="border-radius: 10px;">
                        <i class="bi bi-info-circle-fill fs-5 text-warning"></i>
                        <div>كلمة المرور الموحدة لجميع الحسابات: <code class="fw-bold fs-6">Admin@123456</code></div>
                    </div>

                    <!-- Role 1: Admin -->
                    <div class="card border mb-2 shadow-sm" style="border-radius: 12px;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="badge bg-danger p-2 rounded-3"><i class="bi bi-shield-lock-fill"></i></div>
                                <div>
                                    <strong class="d-block text-dark small">مدير المنصة (Admin)</strong>
                                    <code class="text-muted" id="adminEmail">admin@contracting.com</code>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('admin@contracting.com', this)" title="نسخ البريد">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Role 2: Contractor -->
                    <div class="card border mb-2 shadow-sm" style="border-radius: 12px;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="badge bg-warning text-dark p-2 rounded-3"><i class="bi bi-hammer"></i></div>
                                <div>
                                    <strong class="d-block text-dark small">مقاول معتمد (Contractor)</strong>
                                    <code class="text-muted" id="contractorEmail">contractor@builder.com</code>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('contractor@builder.com', this)" title="نسخ البريد">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Role 3: Client -->
                    <div class="card border mb-3 shadow-sm" style="border-radius: 12px;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="badge bg-success p-2 rounded-3"><i class="bi bi-person-fill"></i></div>
                                <div>
                                    <strong class="d-block text-dark small">عميل / صاحب مشروع (Client)</strong>
                                    <code class="text-muted" id="clientEmail">client@home.com</code>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('client@home.com', this)" title="نسخ البريد">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2" style="border-radius: 10px;">
                        <i class="bi bi-box-arrow-in-left"></i>
                        <span>الانتقال لصفحة تسجيل الدخول</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Quick Access Pill Button for Testers -->
    <button type="button" class="btn btn-dark border border-warning shadow-lg position-fixed d-flex align-items-center gap-2 px-3 py-2" data-bs-toggle="modal" data-bs-target="#demoAccountsModal" style="bottom: 24px; left: 24px; z-index: 1080; border-radius: 30px; font-size: 0.85rem; background: #0f172a; color: #f59e0b;">
        <i class="bi bi-key-fill text-warning"></i>
        <span class="fw-bold d-none d-md-inline">حسابات التجربة السريعة</span>
    </button>

    <!-- Real-time Toast Notifications Container -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1090;" id="toastNotificationContainer"></div>

    <!-- Bootstrap 5 & SignalR Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // Setup SignalR Real-time Hub Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/platform")
            .withAutomaticReconnect()
            .build();

        connection.start().then(function () {
            console.log("SignalR Connected to Bunyan Platform Hub.");
        }).catch(function (err) {
            console.warn("SignalR connection skipped or user anonymous:", err.toString());
        });

        // Real-time Notification Event Handler
        connection.on("ReceiveNotification", function (notification) {
            showToastNotification(notification);
            updateNavBadgeIncrement();
            prependNavNotification(notification);
        });

        function showToastNotification(n) {
            const container = document.getElementById("toastNotificationContainer");
            if (!container) return;

            const toastEl = document.createElement("div");
            toastEl.className = "toast show shadow border bg-white mb-2";
            toastEl.setAttribute("role", "alert");
            toastEl.innerHTML = `
                <div class="toast-header bg-primary text-white d-flex justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bell-fill"></i>
                        <strong class="me-auto">${escapeHtml(n.title)}</strong>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body">
                    <p class="mb-2 text-dark small">${escapeHtml(n.message)}</p>
                    ${n.actionUrl ? `<a href="${n.actionUrl}" class="btn btn-sm btn-primary-custom py-1 px-3 d-inline-flex align-items-center gap-1"><span>معاينة</span><i class="bi bi-arrow-left"></i></a>` : ''}
                </div>
            `;
            container.appendChild(toastEl);
            setTimeout(() => {
                toastEl.classList.remove("show");
                setTimeout(() => toastEl.remove(), 500);
            }, 7000);
        }

        function updateNavBadgeIncrement() {
            const badge = document.getElementById("navUnreadBadge");
            if (badge) {
                let current = parseInt(badge.textContent) || 0;
                current++;
                badge.textContent = current;
                badge.classList.remove("d-none");
            }
        }

        function prependNavNotification(n) {
            const container = document.getElementById("navNotificationsContainer");
            if (!container) return;

            const loading = document.getElementById("navNotificationsLoading");
            if (loading) loading.remove();

            const item = document.createElement("a");
            item.href = n.actionUrl || "/Notifications";
            item.className = "dropdown-item p-3 border-bottom d-flex align-items-start gap-2 bg-light bg-opacity-75";
            item.innerHTML = `
                <i class="bi bi-bell text-primary fs-5 mt-1 flex-shrink-0"></i>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="d-block text-dark text-truncate small">${escapeHtml(n.title)}</strong>
                        <span class="badge bg-primary text-white" style="font-size: 0.6rem;">الآن</span>
                    </div>
                    <small class="text-muted d-block text-truncate" style="max-width: 240px;">${escapeHtml(n.message)}</small>
                </div>
            `;
            container.insertBefore(item, container.firstChild);
        }

        function loadNotificationsSummary() {
            const container = document.getElementById("navNotificationsContainer");
            const badge = document.getElementById("navUnreadBadge");
            if (!container || !badge) return;

            fetch('/Notifications/GetUnreadSummary')
                .then(res => res.json())
                .then(data => {
                    if (data.unreadCount > 0) {
                        badge.textContent = data.unreadCount;
                        badge.classList.remove("d-none");
                    } else {
                        badge.textContent = "0";
                        badge.classList.add("d-none");
                    }

                    container.innerHTML = "";
                    if (!data.recentNotifications || data.recentNotifications.length === 0) {
                        container.innerHTML = '<div class="p-3 text-center text-muted small">لا توجد إشعارات جديدة</div>';
                    } else {
                        data.recentNotifications.forEach(n => {
                            const item = document.createElement("a");
                            item.href = n.actionUrl || "/Notifications";
                            item.className = `dropdown-item p-3 border-bottom d-flex align-items-start gap-2 ${!n.isRead ? 'bg-light bg-opacity-75' : ''}`;
                            item.innerHTML = `
                                <i class="bi bi-bell ${!n.isRead ? 'text-primary' : 'text-muted'} fs-5 mt-1 flex-shrink-0"></i>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="d-block text-dark text-truncate small">${escapeHtml(n.title)}</strong>
                                        <small class="text-muted" style="font-size: 0.65rem;">${n.timeAgo}</small>
                                    </div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 240px;">${escapeHtml(n.message)}</small>
                                </div>
                            `;
                            container.appendChild(item);
                        });
                    }
                })
                .catch(err => console.error(err));
        }

        function markAllNotificationsRead(e) {
            e.stopPropagation();
            fetch('/Notifications/MarkAllAsRead', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const badge = document.getElementById("navUnreadBadge");
                    if (badge) {
                        badge.textContent = "0";
                        badge.classList.add("d-none");
                    }
                    const container = document.getElementById("navNotificationsContainer");
                    if (container) {
                        container.querySelectorAll(".bg-light").forEach(el => el.classList.remove("bg-light", "bg-opacity-75"));
                    }
                }
            })
            .catch(err => console.error(err));
        }

        function escapeHtml(text) {
            if (!text) return "";
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        function copyToClipboard(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check2 text-success"></i>';
                setTimeout(() => { btn.innerHTML = originalHtml; }, 2000);
            }).catch(err => {
                console.error("Clipboard copy failed:", err);
            });
        }

        // Initialize on page load for authenticated users
        document.addEventListener("DOMContentLoaded", function () {
            if (document.getElementById("navUnreadBadge")) {
                loadNotificationsSummary();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
