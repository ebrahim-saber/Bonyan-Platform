@using ContractingPlatform.Domain.Enums
@using ContractingPlatform.Application.DTOs.Projects
@model List<BidListItemDto>
@{
    ViewData["Title"] = "عروضي المقدمة";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1"><i class="bi bi-send-check text-primary me-2"></i>عروض الأسعار التي قدمتها</h3>
        <p class="text-muted small mb-0">تابع حالة عروضك وقرارات العملاء بشأن المشاريع المتقدم إليها</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-custom p-5 text-center">
            <i class="bi bi-tag text-muted display-3 mb-3"></i>
            <h4 class="fw-bold">لم تقم بتقديم أي عروض أسعار حتى الآن</h4>
            <p class="text-muted small mb-4">تصفح المشاريع المفتوحة الآن في منطقتك وابدأ بتقديم عروضك التنافسية.</p>
            <div>
                <a asp-controller="Projects" asp-action="Index" class="btn btn-primary-custom px-4">استعراض المشاريع</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded-3 shadow-sm border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4">رقم العرض</th>
                        <th>السعر المقدم</th>
                        <th>مدة الإنجاز</th>
                        <th>الحالة</th>
                        <th>تاريخ الإرسال</th>
                        <th class="text-end px-4">الملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bid in Model)
                    {
                        <tr>
                            <td class="px-4 fw-bold">#@bid.Id</td>
                            <td class="fw-bold text-primary">@bid.ProposedPrice.ToString("N0") ر.س</td>
                            <td>@bid.DurationDays يوم</td>
                            <td>
                                <span class="badge @(bid.Status == BidStatus.Accepted ? "bg-success" : bid.Status == BidStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">
                                    @(bid.Status switch {
                                        BidStatus.Submitted => "قيد مراجعة العميل",
                                        BidStatus.Accepted => "تم قبول العرض والتعاقد",
                                        BidStatus.Rejected => "تم اختيار عرض آخر",
                                        _ => bid.Status.ToString()
                                    })
                                </span>
                            </td>
                            <td>@bid.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-end px-4 small text-muted">
                                @(bid.Notes.Length > 50 ? bid.Notes.Substring(0, 50) + "..." : bid.Notes)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
