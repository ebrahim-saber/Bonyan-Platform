@model ContractingPlatform.Application.DTOs.Auth.RegisterClientDto
@{
    ViewData["Title"] = "تسجيل حساب عميل جديد";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-custom p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center p-3 mb-2">
                        <i class="bi bi-person-plus fs-1"></i>
                    </div>
                    <h3 class="fw-bold">تسجيل حساب عميل (أفراد / شركات)</h3>
                    <p class="text-muted small">اطرح مشاريعك، استقبل عروض الأسعار، وأدر الدفعات والتعاقدات بكل أمان</p>
                </div>

                <form asp-action="RegisterClient" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold small">الاسم الكامل / اسم الجهة</label>
                        <input asp-for="FullName" class="form-control" placeholder="مثال: عبدالله ناصر" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold small">البريد الإلكتروني</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-bold small">رقم الجوال</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="05XXXXXXXX" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-bold small">المدينة</label>
                            <input asp-for="City" class="form-control" placeholder="الرياض، جدة، الدمام..." required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="District" class="form-label fw-bold small">الحي السكني</label>
                            <input asp-for="District" class="form-control" placeholder="مثال: حي الملقا" required />
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold small">كلمة المرور</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small">تأكيد كلمة المرور</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2">
                        <i class="bi bi-check-circle me-1"></i> إنشاء الحساب والبدء
                    </button>
                </form>

                <div class="text-center mt-4">
                    <span class="text-muted small">لديك حساب بالفعل؟</span>
                    <a asp-action="Login" class="fw-bold small text-primary text-decoration-none">تسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>
