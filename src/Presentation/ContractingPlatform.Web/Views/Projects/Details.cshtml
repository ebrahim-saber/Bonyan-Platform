@using ContractingPlatform.Domain.Enums
@model ContractingPlatform.Application.DTOs.Projects.ProjectDetailsDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>الرئيسية</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">المشاريع</a></li>
            <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Project Main Details Column -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <span class="badge-soft-primary px-3 py-2">
                        <i class="bi @Model.CategoryIcon me-1"></i> @Model.CategoryName
                    </span>
                    <span class="badge-soft-success d-inline-flex align-items-center gap-2 px-3 py-2">
                        <span class="pulse-dot"></span>
                        <span>@(Model.Status switch {
                            ProjectStatus.OpenForBids => "متاح لاستقبال العروض",
                            ProjectStatus.InProgress => "قيد التنفيذ والتعاقد",
                            ProjectStatus.Completed => "مشروع مكتمل",
                            _ => "تحت المراجعة"
                        })</span>
                    </span>
                </div>

                <h2 class="fw-extrabold text-dark mb-3">@Model.Title</h2>

                <div class="d-flex flex-wrap gap-4 text-muted small mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <span>@Model.City - @Model.District</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-calendar3 text-primary"></i>
                        <span>تاريخ الطرح: @Model.CreatedAt.ToString("yyyy/MM/dd")</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <i class="bi bi-chat-left-dots text-warning"></i>
                        <span>@Model.BidsCount عروض مقدمة</span>
                    </div>
                </div>

                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-card-text text-primary me-1"></i> نطاق العمل والمواصفات الفنية:
                </h5>
                <p class="text-secondary mb-4" style="white-space: pre-line; line-height: 1.85; font-size: 1.02rem;">
                    @Model.Description
                </p>

                @if (!string.IsNullOrEmpty(Model.DetailedAddress))
                {
                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-pin-map-fill text-danger"></i>
                            <span>تفاصيل الموقع الجغرافي للعقار:</span>
                        </h6>
                        <p class="small text-muted mb-0">@Model.DetailedAddress</p>
                    </div>
                }

                <!-- Engineering Blueprints & Site Photos Attachments -->
                @if (Model.Attachments != null && Model.Attachments.Any())
                {
                    <div class="mb-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-folder-symlink-fill text-primary"></i>
                                <span>المخططات الهندسية ومرفقات المشروع (@Model.Attachments.Count)</span>
                            </h5>
                            <span class="badge bg-light text-secondary border small">وثائق معتمدة من العميل</span>
                        </div>

                        <div class="row g-3">
                            @foreach (var att in Model.Attachments)
                            {
                                <div class="col-md-6">
                                    <div class="card p-3 rounded-3 border h-100 bg-light d-flex flex-row align-items-center justify-content-between gap-2">
                                        <div class="d-flex align-items-center gap-3 overflow-hidden">
                                            <div class="rounded p-2 @(att.IsPdf ? "bg-danger bg-opacity-10 text-danger" : att.IsDwg ? "bg-primary bg-opacity-10 text-primary" : "bg-success bg-opacity-10 text-success") fs-3 flex-shrink-0">
                                                <i class="bi @(att.IsPdf ? "bi-file-earmark-pdf-fill" : att.IsDwg ? "bi-file-earmark-ruled-fill" : "bi-file-earmark-image-fill")"></i>
                                            </div>
                                            <div class="overflow-hidden">
                                                <h6 class="fw-bold mb-0 text-dark text-truncate" title="@att.FileName">@att.FileName</h6>
                                                <small class="text-muted">@att.FormattedSize</small>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <a href="@att.FilePath" target="_blank" class="btn btn-outline-custom btn-sm py-1 px-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-eye"></i>
                                                <span>معاينة</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Contractor Action Box -->
                @if (User.IsInRole(nameof(UserType.Contractor)) && Model.Status == ProjectStatus.OpenForBids)
                {
                    <div class="p-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 border border-warning" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);">
                        <div>
                            <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                                <i class="bi bi-hammer text-warning fs-4"></i>
                                <span>هل ترغب بتقديم عرض تنفيذ لهذا المشروع؟</span>
                            </h5>
                            <p class="text-muted small mb-0">أرسل عرض سعرك المالي، مدة التنفيذ المقترحة، وتفاصيل المواد والمصنعية للعميل.</p>
                        </div>
                        <div>
                            @if (Model.HasUserBid)
                            {
                                <span class="badge-soft-success px-3 py-2 fs-6 d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>تم تقديم عرضك مسبقاً</span>
                                </span>
                            }
                            else
                            {
                                <a asp-controller="Bids" asp-action="Submit" asp-route-projectId="@Model.Id" class="btn btn-accent px-4 py-2 fw-bold shadow-gold text-nowrap d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-send-fill"></i>
                                    <span>تقديم عرض سعر</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Bids Section -->
            <div class="card card-custom p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-extrabold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-cash-stack text-success"></i>
                            <span>عروض الأسعار المقدمة (@Model.Bids.Count)</span>
                        </h4>
                        <p class="text-muted small mb-0">نظام المناقصات المغلقة يضمن تكافؤ الفرص وحماية الخصوصية التجارية</p>
                    </div>
                </div>

                @if (!Model.Bids.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                            <i class="bi bi-chat-square-dots text-muted fs-2"></i>
                        </div>
                        <h5 class="fw-bold text-dark">لا توجد عروض أسعار حتى الآن</h5>
                        <p class="small text-muted mb-0">كن أول مقاول معتمد يطّلع على المتطلبات ويقدم عرضاً احترافياً.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var bid in Model.Bids)
                        {
                            <div class="card p-3 rounded-3 border @(bid.Status == BidStatus.Accepted ? "border-success bg-success bg-opacity-10" : "bg-white")" style="transition: all 0.2s ease;">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-7">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <h5 class="fw-bold text-dark mb-0">@bid.ContractorCompanyName</h5>
                                            <span class="badge bg-warning text-dark px-2 py-1 small fw-bold">
                                                <i class="bi bi-star-fill text-dark me-1"></i>@bid.ContractorRating.ToString("F1") (@bid.ContractorTotalReviews تقييم)
                                            </span>
                                            @if (bid.Status == BidStatus.Accepted)
                                            {
                                                <span class="badge-soft-success">
                                                    <i class="bi bi-check2-circle me-1"></i> العرض المقبول رسمياً
                                                </span>
                                            }
                                        </div>
                                        <p class="small text-secondary mb-2" style="line-height: 1.6;">@bid.Notes</p>
                                        <div class="d-flex flex-wrap gap-3 text-muted small">
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-calendar-check text-primary me-1"></i> المدة: <strong>@bid.DurationDays يوم</strong>
                                            </span>
                                            @if (bid.MaterialCost.HasValue && bid.LaborCost.HasValue)
                                            {
                                                <span class="badge bg-light text-secondary border">
                                                    <i class="bi bi-boxes me-1"></i> المواد: @bid.MaterialCost:N0 ر.س | المصنعية: @bid.LaborCost:N0 ر.س
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-5 text-md-end">
                                        <div class="fs-4 fw-extrabold text-primary mb-2">
                                            @bid.ProposedPrice.ToString("N0") <span class="fs-6 fw-normal text-muted">ر.س</span>
                                        </div>
                                        
                                        @if (User.IsInRole(nameof(UserType.Client)) && Model.Status == ProjectStatus.OpenForBids)
                                        {
                                            <form asp-controller="Bids" asp-action="Accept" method="post" onsubmit="return confirm('بالضغط على تأكيد، سيتم قبول هذا العرض والانتقال لمرحلة صياغة العقد والدفعات المجمدة. هل ترغب بالاستمرار؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bidId" value="@bid.Id" />
                                                <button type="submit" class="btn btn-success btn-sm px-3 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <span>قبول العرض وبدء التعاقد</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Summary Column -->
        <div class="col-lg-4">
            <!-- Project Budget Box -->
            <div class="card card-custom p-4 mb-4">
                <h5 class="fw-extrabold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-wallet2 text-success"></i>
                    <span>الميزانية والجدول الزمني</span>
                </h5>
                <div class="bg-light p-3 rounded-3 mb-3 border">
                    <span class="text-muted small d-block mb-1">الميزانية التقديرية المرصودة:</span>
                    <h4 class="fw-extrabold text-success mb-0">
                        @(Model.ExpectedBudgetMin.HasValue ? $"{Model.ExpectedBudgetMin:N0} - {Model.ExpectedBudgetMax:N0} ر.س" : "غير محددة")
                    </h4>
                </div>

                @if (Model.DesiredExecutionDate.HasValue)
                {
                    <div class="mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-event text-primary fs-5"></i>
                        <div>
                            <span class="text-muted small d-block">التاريخ المرغوب للبدء:</span>
                            <span class="fw-bold text-dark">@Model.DesiredExecutionDate.Value.ToString("yyyy/MM/dd")</span>
                        </div>
                    </div>
                }

                <hr class="my-3 text-muted opacity-25">

                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-person-circle fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">صاحب المشروع:</span>
                        <span class="fw-bold text-dark">@Model.ClientName</span>
                    </div>
                </div>
            </div>

            <!-- Escrow Guarantee Notice Box -->
            <div class="card card-custom p-4 bg-light border-0" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rounded-circle bg-success text-white p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <h6 class="fw-extrabold text-dark mb-0">ضمان وحماية منصة بُنيان</h6>
                </div>
                <p class="small text-secondary mb-3" style="line-height: 1.7;">
                    كافة التعاقدات تخضع تلقائياً لنظام <strong>حساب الضمان المشترك (Escrow)</strong>، حيث يتم حجز المبالغ ولا يتم تحويلها للمقاول إلا بعد مصادقة العميل على جودة تسليم المرحلة.
                </p>
                <div class="d-flex flex-column gap-2 small text-secondary">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2 text-success fw-bold"></i>
                        <span>عقد تنفيذي إلكتروني ملزم للطرفين</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2 text-success fw-bold"></i>
                        <span>تجزئة الدفعات حسب مراحل الإنجاز الفعلي</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2 text-success fw-bold"></i>
                        <span>لجنة فض نزاعات هندسية معتمدة</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
