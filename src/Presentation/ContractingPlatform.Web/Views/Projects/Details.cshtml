@using ContractingPlatform.Domain.Enums
@model ContractingPlatform.Application.DTOs.Projects.ProjectDetailsDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">المشاريع</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Project Main Details Column -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4 border">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        <i class="bi @Model.CategoryIcon me-1"></i> @Model.CategoryName
                    </span>
                    <span class="badge bg-success-subtle text-success fs-6 px-3 py-1">
                        @(Model.Status switch {
                            ProjectStatus.OpenForBids => "متاح لتقديم العروض",
                            ProjectStatus.InProgress => "قيد التنفيذ والتعاقد",
                            ProjectStatus.Completed => "مكتمل",
                            _ => "تحت المراجعة"
                        })
                    </span>
                </div>

                <h3 class="fw-bold mb-3">@Model.Title</h3>

                <div class="d-flex flex-wrap gap-4 text-muted small mb-4 pb-3 border-bottom">
                    <div><i class="bi bi-geo-alt text-danger me-1"></i> @Model.City - @Model.District</div>
                    <div><i class="bi bi-clock text-secondary me-1"></i> طرح منذ: @Model.CreatedAt.ToString("yyyy/MM/dd")</div>
                    <div><i class="bi bi-card-checklist text-primary me-1"></i> @Model.BidsCount عروض مقدمة</div>
                </div>

                <h5 class="fw-bold text-dark mb-2">وصف المشروع والمتطلبات:</h5>
                <p class="text-secondary leading-relaxed mb-4" style="white-space: pre-line; line-height: 1.8;">
                    @Model.Description
                </p>

                @if (!string.IsNullOrEmpty(Model.DetailedAddress))
                {
                    <div class="bg-light p-3 rounded mb-4">
                        <h6 class="fw-bold mb-1"><i class="bi bi-pin-map text-danger me-1"></i> تفاصيل الموقع الجغرافي:</h6>
                        <p class="small text-muted mb-0">@Model.DetailedAddress</p>
                    </div>
                }

                <!-- Contractor Action Box -->
                @if (User.IsInRole(nameof(UserType.Contractor)) && Model.Status == ProjectStatus.OpenForBids)
                {
                    <div class="border border-warning bg-warning bg-opacity-10 p-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><i class="bi bi-hammer text-warning me-1"></i> هل أنت مهتم بتنفيذ هذا المشروع؟</h5>
                            <p class="text-muted small mb-0">أرسل عرض سعرك المالي ومدة التنفيذ وخطة العمل لصاحب المشروع الآن.</p>
                        </div>
                        <div>
                            @if (Model.HasUserBid)
                            {
                                <span class="badge bg-success p-2 px-3 fs-6"><i class="bi bi-check2-circle me-1"></i> لقد قمت بتقديم عرض مسبقاً</span>
                            }
                            else
                            {
                                <a asp-controller="Bids" asp-action="Submit" asp-route-projectId="@Model.Id" class="btn btn-accent px-4 py-2 fw-bold text-nowrap">
                                    <i class="bi bi-send me-1"></i> تقديم عرض سعر
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Bids Section -->
            <div class="card card-custom p-4 border">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0"><i class="bi bi-cash-coin text-success me-2"></i>عروض الأسعار المقدمة (@Model.Bids.Count)</h4>
                </div>

                @if (!Model.Bids.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-square-dots fs-1 d-block mb-2"></i>
                        <p class="mb-0">لا توجد عروض أسعار حتى الآن، كن أول من يقدم عرضاً!</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var bid in Model.Bids)
                        {
                            <div class="card border p-3 @(bid.Status == BidStatus.Accepted ? "border-success bg-success bg-opacity-10" : "")">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-7">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h5 class="fw-bold mb-0">@bid.ContractorCompanyName</h5>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>@bid.ContractorRating.ToString("F1") (@bid.ContractorTotalReviews تقييم)</span>
                                            @if (bid.Status == BidStatus.Accepted)
                                            {
                                                <span class="badge bg-success">العرض المقبول</span>
                                            }
                                        </div>
                                        <p class="small text-secondary mb-2">@bid.Notes</p>
                                        <div class="d-flex gap-3 text-muted small">
                                            <span><i class="bi bi-calendar3 me-1"></i> مدة التنفيذ: <strong>@bid.DurationDays يوم</strong></span>
                                            @if (bid.MaterialCost.HasValue && bid.LaborCost.HasValue)
                                            {
                                                <span><i class="bi bi-box-seam me-1"></i> المواد: @bid.MaterialCost:N0 ر.س | المصنعية: @bid.LaborCost:N0 ر.س</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-5 text-md-end">
                                        <div class="fs-4 fw-bold text-primary mb-2">
                                            @bid.ProposedPrice.ToString("N0") <span class="fs-6 fw-normal text-muted">ر.س</span>
                                        </div>
                                        
                                        @if (User.IsInRole(nameof(UserType.Client)) && Model.Status == ProjectStatus.OpenForBids)
                                        {
                                            <form asp-controller="Bids" asp-action="Accept" method="post" onsubmit="return confirm('هل أنت متأكد من رغبتك في قبول هذا العرض والبدء في توثيق العقد؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bidId" value="@bid.Id" />
                                                <button type="submit" class="btn btn-success btn-sm px-3 fw-bold">
                                                    <i class="bi bi-check2-circle me-1"></i> قبول العرض والتعاقد
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Summary Column -->
        <div class="col-lg-4">
            <!-- Project Budget Box -->
            <div class="card card-custom p-4 mb-4 border">
                <h5 class="fw-bold mb-3">تفاصيل الميزانية والتنفيذ</h5>
                <div class="mb-3">
                    <span class="text-muted small d-block">الميزانية المتوقعة من العميل:</span>
                    <h4 class="fw-bold text-success mb-0">
                        @(Model.ExpectedBudgetMin.HasValue ? $"{Model.ExpectedBudgetMin:N0} - {Model.ExpectedBudgetMax:N0} ر.س" : "غير محددة")
                    </h4>
                </div>
                @if (Model.DesiredExecutionDate.HasValue)
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block">التاريخ المرغوب للبدء:</span>
                        <span class="fw-bold text-dark">@Model.DesiredExecutionDate.Value.ToString("yyyy/MM/dd")</span>
                    </div>
                }
                <hr>
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-person fs-3"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">صاحب المشروع:</span>
                        <span class="fw-bold">@Model.ClientName</span>
                    </div>
                </div>
            </div>

            <!-- Escrow Guarantee Notice Box -->
            <div class="card card-custom p-4 border bg-light">
                <h6 class="fw-bold text-primary mb-2"><i class="bi bi-shield-check fs-5 me-1"></i> حماية وضمان منصة بُنيان</h6>
                <p class="small text-muted mb-2">
                    جميع المبالغ المدفوعة تخضع لنظام <strong>حساب الضمان المشترك (Escrow)</strong>، حيث يتم حجز الدفعة ولا يتم تسليمها للمقاول إلا بعد موافقة العميل على استلام المرحلة والتأكد من مطابقتها للمواصفات.
                </p>
                <ul class="small text-muted ps-3 mb-0">
                    <li>عقد إلكتروني ملزم للطرفين</li>
                    <li>تقسيم الدفعات حسب مراحل الإنجاز</li>
                    <li>لجنة فض نزاعات هندسية معتمدة</li>
                </ul>
            </div>
        </div>
    </div>
</div>
